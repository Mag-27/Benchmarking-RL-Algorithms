      "source": [
        "class SAC:\n",
        "\n",
        "    def __init__(self, env, gamma, tau,\n",
        "             bufferSize, entropyLR, updateFrequency,\n",
        "             policyOptimizerFn, valueOptimizerFn_1, valueOptimizerFn_2,\n",
        "             policyOptimizerLR, valueOptimizerLR,\n",
        "             alphaOptimizerFn,\n",
        "             MAX_TRAIN_EPISODES, MAX_EVAL_EPISODE,\n",
        "             hDims,\n",
        "             batchSize, minSamples):\n",
        "        \"\"\"\n",
        "        Args:\n",
        "            env: gym environment\n",
        "            gamma (float): discount factor\n",
        "            tau (float): target update rate\n",
        "            bufferSize (int): replay buffer size\n",
        "            batchSize (int): training batch size\n",
        "        \"\"\"\n",
        "        self.env                = env\n",
        "        self.gamma              = gamma\n",
        "        self.tau                = tau\n",
        "        self.batchSize          = batchSize\n",
        "        self.minSamples         = minSamples\n",
        "        self.MAX_TRAIN_EPISODES = MAX_TRAIN_EPISODES\n",
        "        self.MAX_EVAL_EPISODES  = MAX_EVAL_EPISODE\n",
        "        self.updateFrequency    = updateFrequency\n",
        "        self.MAX_VALUE_GRAD     = float('inf')\n",
        "        self.MAX_POLICY_GRAD    = float('inf')\n",
        "\n",
        "        S = env.observation_space.shape[0]\n",
        "        A = env.action_space.shape[0]\n",
        "        envActionRange = (\n",
        "            torch.FloatTensor(env.action_space.low),\n",
        "            torch.FloatTensor(env.action_space.high)\n",
        "        )\n",
        "\n",
        "        self.targetValueNetwork_1 = ValueNetwork(S, A, hDims)\n",
        "        self.targetValueNetwork_2 = ValueNetwork(S, A, hDims)\n",
        "        self.onlineValueNetwork_1 = ValueNetwork(S, A, hDims)\n",
        "        self.onlineValueNetwork_2 = ValueNetwork(S, A, hDims)\n",
        "\n",
        "        self.policyNetwork = PolicyNetwork(S, envActionRange, hDims)\n",
        "\n",
        "        self.alphaOptimizerFn   = alphaOptimizerFn([self.policyNetwork.logAlpha], lr=entropyLR)\n",
        "        self.valueOptimizerFn_1 = valueOptimizerFn_1(self.onlineValueNetwork_1.parameters(), lr=valueOptimizerLR)\n",
        "        self.valueOptimizerFn_2 = valueOptimizerFn_2(self.onlineValueNetwork_2.parameters(), lr=valueOptimizerLR)\n",
        "        self.policyOptimizerFn  = policyOptimizerFn(self.policyNetwork.parameters(), lr=policyOptimizerLR)\n",
        "\n",
        "        self.updateTargetNetworks()\n",
        "\n",
        "        self.rBuffer      = ReplayBuffer(bufferSize, batchSize, seed=0)\n",
        "        self.trainRewards = []\n",
        "        self.evalRewards  = []\n",
        "    def selectAction(self, state):\n",
        "        \"\"\"\n",
        "        Args:\n",
        "            state (array): current state\n",
        "\n",
        "        Returns:\n",
        "            action (array): action sampled from policy\n",
        "        \"\"\"\n",
        "        state  = torch.FloatTensor(state).unsqueeze(0)\n",
        "        with torch.no_grad():\n",
        "            action, _, _ = self.policyNetwork(state)\n",
        "        return action.squeeze(0).numpy()\n",
        "\n",
        "    def trainNetworks(self, batch):\n",
        "        \"\"\"\n",
        "        Args:\n",
        "            batch: sampled transitions\n",
        "\n",
        "        Updates:\n",
        "            critics, policy, entropy coefficient\n",
        "        \"\"\"\n",
        "        envActionRange              = (\n",
        "            torch.FloatTensor(self.env.action_space.low),\n",
        "            torch.FloatTensor(self.env.action_space.high)\n",
        "        )\n",
        "        actionLowVal, actionHighVal = envActionRange\n",
        "        ss, acts, rs, sNexts, dones = self.rBuffer.splitExperiences(batch)\n",
        "\n",
        "\n",
        "        as_current, _, logp = self.policyNetwork(ss)\n",
        "\n",
        "\n",
        "        alpha = torch.exp(self.policyNetwork.logAlpha).detach()\n",
        "        q_current_1 = self.onlineValueNetwork_1(ss, as_current)\n",
        "        q_current_2 = self.onlineValueNetwork_2(ss, as_current)\n",
        "        q_current   = torch.min(q_current_1, q_current_2)\n",
        "        policyLoss  = (alpha * logp - q_current).mean()\n",
        "\n",
        "        self.policyOptimizerFn.zero_grad()\n",
        "        policyLoss.backward()\n",
        "        nn.utils.clip_grad_norm_(self.policyNetwork.parameters(), self.MAX_POLICY_GRAD)\n",
        "        self.policyOptimizerFn.step()\n",
        "\n",
        "\n",
        "        as_current2, _, logp2 = self.policyNetwork(ss)\n",
        "        targetEntropy = -1.0 * np.prod(actionHighVal.shape)\n",
        "        alpha_target  = (logp2 + targetEntropy).detach()\n",
        "        alphaLoss     = -(self.policyNetwork.logAlpha * alpha_target).mean()\n",
        "\n",
        "        self.alphaOptimizerFn.zero_grad()\n",
        "        alphaLoss.backward()\n",
        "        self.alphaOptimizerFn.step()\n",
        "\n",
        "        alpha = torch.exp(self.policyNetwork.logAlpha).detach()\n",
        "        with torch.no_grad():\n",
        "            as_p, _, logp_p = self.policyNetwork(sNexts)\n",
        "            q_p_1    = self.targetValueNetwork_1(sNexts, as_p)\n",
        "            q_p_2    = self.targetValueNetwork_2(sNexts, as_p)\n",
        "            q_p      = torch.min(q_p_1, q_p_2)\n",
        "            target_q = rs + self.gamma * (q_p - alpha * logp_p) * (1 - dones)\n",
        "\n",
        "        q_1      = self.onlineValueNetwork_1(ss, acts)\n",
        "        q_2      = self.onlineValueNetwork_2(ss, acts)\n",
        "        q_1_loss = (0.5 * (q_1 - target_q) ** 2).mean()\n",
        "        q_2_loss = (0.5 * (q_2 - target_q) ** 2).mean()\n",
        "\n",
        "\n",
        "        self.valueOptimizerFn_1.zero_grad()\n",
        "        q_1_loss.backward()\n",
        "        nn.utils.clip_grad_norm_(self.onlineValueNetwork_1.parameters(), self.MAX_VALUE_GRAD)\n",
        "        self.valueOptimizerFn_1.step()\n",
        "\n",
        "\n",
        "        self.valueOptimizerFn_2.zero_grad()\n",
        "        q_2_loss.backward()\n",
        "        nn.utils.clip_grad_norm_(self.onlineValueNetwork_2.parameters(), self.MAX_VALUE_GRAD)\n",
        "        self.valueOptimizerFn_2.step()\n",
        "\n",
        "    def updateTargetNetworks(self):\n",
        "        \"\"\"\n",
        "        Performs Polyak update of target networks\n",
        "        \"\"\"\n",
        "        tau = self.tau\n",
        "        for tParam, oParam in zip(self.targetValueNetwork_1.parameters(),\n",
        "                                   self.onlineValueNetwork_1.parameters()):\n",
        "            mixedWeights = (1 - tau) * tParam.data + tau * oParam.data\n",
        "            tParam.data.copy_(mixedWeights)\n",
        "\n",
        "        for tParam, oParam in zip(self.targetValueNetwork_2.parameters(),\n",
        "                                   self.onlineValueNetwork_2.parameters()):\n",
        "            mixedWeights = (1 - tau) * tParam.data + tau * oParam.data\n",
        "            tParam.data.copy_(mixedWeights)\n",
        "\n",
        "    def trainAgent(self):\n",
        "        \"\"\"\n",
        "        Runs training episodes\n",
        "\n",
        "        Returns:\n",
        "            trainRewards (list): reward per episode\n",
        "        \"\"\"\n",
        "        self.updateTargetNetworks()\n",
        "        for e in range(self.MAX_TRAIN_EPISODES):\n",
        "            envActionRange = (\n",
        "                torch.FloatTensor(self.env.action_space.low),\n",
        "                torch.FloatTensor(self.env.action_space.high)\n",
        "            )\n",
        "            s, _ = self.env.reset()\n",
        "            done  = False\n",
        "            episodeReward = 0\n",
        "\n",
        "            while not done:\n",
        "                if self.rBuffer.length() < self.minSamples:\n",
        "                    a = self.env.action_space.sample()\n",
        "                else:\n",
        "                    a, _, _ = self.policyNetwork(\n",
        "                        torch.FloatTensor(s).unsqueeze(0)\n",
        "                    )\n",
        "                    a = a.squeeze(0).detach().numpy()\n",
        "\n",
        "                s_next, r, terminated, truncated, _ = self.env.step(a)\n",
        "                done = terminated or truncated\n",
        "                experience = (s, a, r, s_next, float(done))\n",
        "                self.rBuffer.store(*experience)\n",
        "                episodeReward += r\n",
        "                s = s_next\n",
        "\n",
        "                if self.rBuffer.length() > self.minSamples:\n",
        "                    experiences = self.rBuffer.sample(self.batchSize)\n",
        "                    self.trainNetworks(experiences)\n",
        "\n",
        "            self.trainRewards.append(episodeReward)\n",
        "\n",
        "            if e % self.updateFrequency == 0:\n",
        "                self.updateTargetNetworks()\n",
        "            if (e + 1) % 5 == 0:\n",
        "              mean_last_50 = np.mean(self.trainRewards[-50:])\n",
        "              print(f\"  Episode {e+1}/{self.MAX_TRAIN_EPISODES} | \"\n",
        "                    f\"Reward: {episodeReward:.1f} | \"\n",
        "                    f\"Mean(last 50): {mean_last_50:.1f} | \"\n",
        "                    f\"Buffer: {self.rBuffer.length()}\")\n",
        "\n",
        "        return self.trainRewards\n",
        "\n",
        "    def evaluateAgent(self):\n",
        "        \"\"\"\n",
        "        Returns:\n",
        "            mean_reward (float): evaluation performance\n",
        "        \"\"\"\n",
        "        rewards = []\n",
        "        for e in range(self.MAX_EVAL_EPISODES):\n",
        "            rs = 0\n",
        "            s, _ = self.env.reset()\n",
        "            done  = False\n",
        "            while not done:\n",
        "                with torch.no_grad():\n",
        "                    _, a_greedy, _ = self.policyNetwork(\n",
        "                        torch.FloatTensor(s).unsqueeze(0)\n",
        "                    )\n",
        "                a = a_greedy.squeeze(0).numpy()\n",
        "                s, r, terminated, truncated, _ = self.env.step(a)\n",
        "                done = terminated or truncated\n",
        "                rs += r\n",
        "            rewards.append(rs)\n",
        "        return np.mean(rewards), np.std(rewards)\n",
        "\n",
        "    def runSAC(self):\n",
        "        \"\"\"\n",
        "        Runs full training pipeline\n",
        "\n",
        "        Returns:\n",
        "            train_rewards, eval_score, training_time\n",
        "        \"\"\"\n",
        "        start_time   = time.time()\n",
        "        trainRewards = self.trainAgent()\n",
        "        eval_score, _= self.evaluateAgent()\n",
        "        training_time = time.time() - start_time\n",
        "        wallclock_elapsed = training_time\n",
        "        return trainRewards, eval_score, training_time, wallclock_elapsed"
      ]
    },
