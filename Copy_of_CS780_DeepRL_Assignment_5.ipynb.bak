        "\n",
        "# GAE sweep plots for Hopper\n",
        "# Your code goes here\n",
        "gae_lambdas   = [0.0, 0.5, 0.95, 1.0]\n",
        "gae_env       = \"Hopper-v4\"\n",
        "gae_results   = {}          # {lambda: [episode_rewards]}\n",
        "\n",
        "for lam in gae_lambdas:\n",
        "    print(f\"\\n{'='*60}\")\n",
        "    print(f\"  GAE A2C on {gae_env}  λ={lam}\")\n",
        "    print(f\"{'='*60}\")\n",
        "    gae_results[lam] = train_a2c(\n",
        "        env_id      = gae_env,\n",
        "        use_gae     = True,\n",
        "        gae_lambda  = lam,\n",
        "        total_timesteps = a2c_total_timesteps\n",
        "    )\n",
        "\n",
        "\n",
        "# ── GAE sweep plots ────────────────────────────────────────────────\n",
        "\n",
        "def moving_average(data, window=50):\n",
        "    if len(data) < window:\n",
        "        return np.array(data)\n",
        "    return np.convolve(data, np.ones(window) / window, mode='valid')\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
        "fig.suptitle(f\"GAE Lambda Sweep — {gae_env}\", fontsize=14)\n",
        "colors = plt.cm.plasma(np.linspace(0, 0.85, len(gae_lambdas)))\n",
        "\n",
        "for (lam, rewards), col in zip(gae_results.items(), colors):\n",
        "    axes[0].plot(rewards, alpha=0.2, color=col)\n",
        "    if len(rewards) >= 50:\n",
        "        axes[0].plot(range(49, len(rewards)),\n",
        "                     moving_average(rewards, 50),\n",
        "                     color=col, linewidth=2, label=f'λ={lam}')\n",
        "    else:\n",
        "        axes[0].plot(rewards, color=col, linewidth=2, label=f'λ={lam}')\n",
        "\n",
        "axes[0].set_xlabel(\"Episode\")\n",
        "axes[0].set_ylabel(\"Return\")\n",
        "axes[0].set_title(\"Episode Returns (smoothed)\")\n",
        "axes[0].legend()\n",
        "axes[0].grid(True, alpha=0.3)\n",
        "\n",
        "for (lam, rewards), col in zip(gae_results.items(), colors):\n",
        "    cum = np.cumsum(rewards) / (np.arange(len(rewards)) + 1)\n",
        "    axes[1].plot(cum, color=col, linewidth=2, label=f'λ={lam}')\n",
        "\n",
        "axes[1].set_xlabel(\"Episode\")\n",
        "axes[1].set_ylabel(\"Cumulative Mean Return\")\n",
        "axes[1].set_title(\"Cumulative Mean Return\")\n",
        "axes[1].legend()\n",
        "axes[1].grid(True, alpha=0.3)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(f\"gae_sweep_{gae_env}.png\", dpi=150, bbox_inches='tight')\n",
        "plt.show()\n"
      ]
    },
