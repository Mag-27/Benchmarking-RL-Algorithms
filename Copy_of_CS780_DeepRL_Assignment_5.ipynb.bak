          ]
        }
      ],
      "source": [
        "if __name__ == \"__main__\":\n",
        "    env = gym.make(\"Pendulum-v1\")\n",
        "\n",
        "    agent = REINFORCE(\n",
        "        env                        = env,\n",
        "        seed                       = 4,\n",
        "        gamma                      = 0.985,\n",
        "        optimizerFn                = torch.optim.Adam,\n",
        "        optimizerLR                = 1e-4,\n",
        "        MAX_TRAIN_EPISODES         = 1000,\n",
        "        MAX_EVAL_EPISODES          =2,\n",
        "    )\n",
        "\n",
        "    train_results, eval_result = agent.runREINFORCE()\n",
        "\n",
        "    print(f\"\\nFinal eval: {eval_result[0]:.1f} ± {eval_result[1]:.1f}\")\n",
        "    env.close()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "_huZeZpcRQVK"
      },
      "source": [
        "# Vanilla Policy Gradient (VPG) [40 marks]"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "LC-8QrvZRQVL"
      },
      "source": [
        "Implement the VPG algorithm. We have studied about VPG algorithm in the Lecture. Use the function definitions (given below).\n",
        "\n",
        "This class implements the VPG Agent, you are required to implement the various methods of this class\n",
        "as outlined below. Note this class is generic and should work with any permissible Gym environment.\n",
        "Run one environment: 'Pendulum-v1'\n",
        "\n",
        "\n",
        "```\n",
        "class VPG():\n",
        "    def __init__(env, seed, gamma, beta,\n",
        "                 optimizerFn,\n",
        "                 optimizerLR,\n",
        "                 MAX_TRAIN_EPISODES, MAX_EVAL_EPISODES,\n",
        "                 explorationStrategyTrainFn,\n",
        "                 explorationStrategyEvalFn)\n",
        "    def initBookKeeping(self)\n",
        "    def performBookKeeping(self, train = True)\n",
        "    def runVPG(self)\n",
        "    def trainAgent(self)\n",
        "    def trainPolicyNetwork(self, experiences)\n",
        "    def evaluateAgent(self)\n",
        "```"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "3ILnurDcdAAF"
      },
      "outputs": [],
      "source": [
        "class VPG:\n",
        "  def __init__(self, env, seed, gamma, beta,\n",
        "                  optimizerFn,\n",
        "                  optimizerLR,\n",
        "                  MAX_TRAIN_EPISODES, MAX_EVAL_EPISODES,\n",
        "                  explorationStrategyTrainFn,\n",
        "                  explorationStrategyEvalFn):\n",
        "          \"\"\"\n",
        "          Parameters\n",
        "          ----------\n",
        "          env                      : Gym environment (continuous or discrete).\n",
        "          seed                     : RNG seed.\n",
        "          gamma                    : Discount factor.\n",
        "          beta                     : Entropy regularisation coefficient.\n",
        "          optimizerFn              : Optimizer class (e.g. torch.optim.Adam).\n",
        "          optimizerLR              : Learning rate (scalar or dict with keys\n",
        "                                    'policy' and 'value' for separate LRs).\n",
        "          MAX_TRAIN_EPISODES       : Number of training episodes.\n",
        "          MAX_EVAL_EPISODES        : Episodes used for each evaluation.\n",
        "          explorationStrategyTrainFn : Callable – receives (pNetwork, state_tensor)\n",
        "                                      and returns (action, log_prob, entropy).\n",
        "          explorationStrategyEvalFn  : Callable – receives (pNetwork, state_tensor)\n",
        "                                      and returns action (greedy / deterministic).\n",
        "          \"\"\"\n",
        "          self.env                       = env\n",
        "          self.seed                      = seed\n",
        "          self.gamma                     = gamma\n",
        "          self.beta                      = beta\n",
        "          self.MAX_TRAIN_EPISODES        = MAX_TRAIN_EPISODES\n",
        "          self.MAX_EVAL_EPISODES         = MAX_EVAL_EPISODES\n",
        "          self.explorationStrategyTrainFn = explorationStrategyTrainFn\n",
        "          self.explorationStrategyEvalFn  = explorationStrategyEvalFn\n",
        "\n",
        "          torch.manual_seed(seed)\n",
        "          np.random.seed(seed)\n",
        "\n",
        "          inDim     = env.observation_space.shape[0]\n",
        "          actionDim = env.action_space.shape[0]\n",
        "\n",
        "          self.pNetwork = createPolicyNetwork(inDim, actionDim)   # GaussianPolicyNetwork\n",
        "          self.vNetwork = createValueNetwork(inDim, 1, actionDim) # scalar V(s)\n",
        "\n",
        "          if isinstance(optimizerLR, dict):\n",
        "              pLR, vLR = optimizerLR['policy'], optimizerLR['value']\n",
        "          else:\n",
        "              pLR = vLR = optimizerLR\n",
        "\n",
        "          self.pOptimizer = optimizerFn(self.pNetwork.parameters(), lr=pLR)\n",
        "          self.vOptimizer = optimizerFn(self.vNetwork.parameters(), lr=vLR)\n",
        "\n",
        "          self.initBookKeeping()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "FB7vw3PVdAAG"
      },
      "outputs": [],
      "source": [
        "class VPG(VPG):\n",
        "  def initBookKeeping(self):\n",
        "        self.trainRewards     = []\n",
        "        self.evalScores       = []\n",
        "        self.episodeSteps     = []\n",
        "        self.trainingTimes    = []\n",
        "        self.wallclockElapsed = []\n",
        "        self.totalSteps       = 0\n",
        "        self.meanReward100    = 0.0\n",
        "        self.meanEvalScore100 = 0.0\n",
        "        self._wallclock_start = time.time()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "g6nhsjHsdAAG"
      },
      "outputs": [],
      "source": [
        "class VPG(VPG):\n",
        "  def performBookKeeping(self, train=True):\n",
        "          if train:\n",
        "              recent = self.trainRewards[-100:]\n",
        "              self.meanReward100 = np.mean(recent) if recent else 0.0\n",
        "          else:\n",
        "              recent = self.evalScores[-100:]\n",
        "              self.meanEvalScore100 = np.mean(recent) if recent else 0.0"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "oEYM5GprdAAG"
      },
      "outputs": [],
      "source": [
        "class VPG(VPG):\n",
        "  def runVPG(self):\n",
        "          resultTrain = self.trainAgent()\n",
        "          resultsEval = self.evaluateAgent()\n",
        "          return resultTrain, resultsEval"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "s311jw_VdAAG"
      },
      "outputs": [],
      "source": [
        "class VPG(VPG):\n",
        "  def trainAgent(self):\n",
        "        results = []\n",
        "\n",
        "        for e in range(self.MAX_TRAIN_EPISODES):\n",
        "            t_start = time.time()\n",
        "            s, _    = self.env.reset(seed=self.seed + e)\n",
        "            done    = False\n",
        "\n",
        "            states, rewards, log_probs, entropies, values = [], [], [], [], []\n",
        "\n",
        "            while not done:\n",
        "                s_tensor = torch.FloatTensor(s).unsqueeze(0)\n",
        "\n",
        "                action, log_prob, entropy = self.explorationStrategyTrainFn(\n",
        "                    self.pNetwork, s_tensor)\n",
        "\n",
        "                action_np = np.array(action).flatten()\n",
        "                action_np = np.clip(action_np,\n",
        "                                    self.env.action_space.low,\n",
        "                                    self.env.action_space.high)\n",
        "\n",
        "                v = self.vNetwork(s_tensor).squeeze()\n",
        "\n",
        "                s, r, terminated, truncated, _ = self.env.step(action_np)\n",
        "                done = terminated or truncated\n",
        "\n",
        "                states.append(s_tensor)\n",
        "                rewards.append(r)\n",
        "                log_probs.append(log_prob)\n",
        "                entropies.append(entropy)\n",
        "                values.append(v)\n",
        "                self.totalSteps += 1\n",
        "\n",
        "            self.trainRewards.append(sum(rewards))\n",
        "            self.episodeSteps.append(len(rewards))\n",
        "\n",
        "            experiences = dict(states=states, rewards=rewards,\n",
        "                               log_probs=log_probs, entropies=entropies,\n",
        "                               values=values)\n",
        "            self.trainPolicyNetwork(experiences)\n",
        "            self.performBookKeeping(train=True)\n",
        "\n",
        "            eval_mean, eval_std = self.evaluateAgent()\n",
        "            self.evalScores.append(eval_mean)\n",
        "            self.performBookKeeping(train=False)\n",
        "\n",
        "            elapsed = time.time() - self._wallclock_start\n",
        "            ep_time = time.time() - t_start\n",
        "            self.trainingTimes.append(ep_time)\n",
        "            self.wallclockElapsed.append(elapsed)\n",
        "\n",
        "            if (e + 1) % 10 == 0:\n",
        "                print(f\"Episode {e+1:4d}/{self.MAX_TRAIN_EPISODES} | \"\n",
        "                      f\"TrainRew(100): {self.meanReward100:8.2f} | \"\n",
        "                      f\"EvalScore(100): {self.meanEvalScore100:8.2f} | \"\n",
        "                      f\"Steps: {self.totalSteps:6d} | Elapsed: {elapsed:5.1f}s\")\n",
        "\n",
        "            results.append((self.totalSteps, self.meanReward100,\n",
        "                            self.meanEvalScore100, ep_time, elapsed))\n",
        "        return results"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "weaGOhaldAAH"
      },
      "outputs": [],
      "source": [
        "class VPG(VPG):\n",
        "  def trainPolicyNetwork(self, experiences):\n",
        "        rewards   = experiences['rewards']\n",
        "        log_probs = torch.stack(experiences['log_probs'])\n",
        "        entropies = torch.stack(experiences['entropies'])\n",
        "        values    = torch.stack(experiences['values'])\n",
        "        states    = torch.cat(experiences['states'], dim=0)\n",
        "\n",
        "        T = len(rewards)\n",
        "\n",
        "        # Monte-Carlo returns G_t\n",
        "        returns = torch.zeros(T)\n",
        "        G = 0.0\n",
        "        for t in reversed(range(T)):\n",
        "            G = rewards[t] + self.gamma * G\n",
        "            returns[t] = G\n",
        "\n",
        "        # Discount weights γ^t\n",
        "        gammas = torch.tensor([self.gamma ** t for t in range(T)], dtype=torch.float32)\n",
        "\n",
        "        # Advantage A_t = G_t - V(s_t)\n",
        "        advantages = returns - values.detach()\n",
        "        if advantages.std() > 1e-8:\n",
        "            advantages = (advantages - advantages.mean()) / (advantages.std() + 1e-8)\n",
        "\n",
        "        # Policy loss: -E[γ^t * A_t * log π] - β*H\n",
        "        policy_loss = -(gammas * advantages * log_probs).mean() \\\n",
        "                      - self.beta * entropies.mean()\n",
        "\n",
        "        self.pOptimizer.zero_grad()\n",
        "        policy_loss.backward()\n",
        "        torch.nn.utils.clip_grad_norm_(self.pNetwork.parameters(), max_norm=1.0)\n",
        "        self.pOptimizer.step()\n",
        "\n",
        "        # Value loss: MSE( G_t, V(s_t) )\n",
        "        fresh_values = self.vNetwork(states).squeeze()\n",
        "        value_loss   = (0.5 * (returns.detach() - fresh_values) ** 2).mean()\n",
        "\n",
        "        self.vOptimizer.zero_grad()\n",
        "        value_loss.backward()\n",
        "        torch.nn.utils.clip_grad_norm_(self.vNetwork.parameters(), max_norm=1.0)\n",
        "        self.vOptimizer.step()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "pMR_IzopdAAH"
      },
      "outputs": [],
      "source": [
        "class VPG(VPG):\n",
        "    def evaluateAgent(self):\n",
        "        rewards = []\n",
        "\n",
        "        for e in range(self.MAX_EVAL_EPISODES):\n",
        "            rs   = 0\n",
        "            s, _ = self.env.reset(seed=self.seed + 10000 + e)\n",
        "\n",
        "            for _ in count():\n",
        "                s_tensor = torch.FloatTensor(s).unsqueeze(0)\n",
        "                action   = self.explorationStrategyEvalFn(self.pNetwork, s_tensor)\n",
        "\n",
        "                action_np = np.array(action).flatten()\n",
        "                action_np = np.clip(action_np,\n",
        "                                    self.env.action_space.low,\n",
        "                                    self.env.action_space.high)\n",
        "\n",
        "                s, r, terminated, truncated, _ = self.env.step(action_np)\n",
        "                rs += r\n",
        "                if terminated or truncated:\n",
        "                    rewards.append(rs)\n",
        "                    break\n",
        "\n",
        "        self.performBookKeeping(train=False)\n",
        "        return np.mean(rewards), np.std(rewards)"
      ]
    },
