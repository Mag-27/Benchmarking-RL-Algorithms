      ],
      "source": [
        "# GAE Lambda Sweep on Hopper\n",
        "''' - Run A2C with different GAE λ values on multiple environments.\n",
        "- For each environment ( Hopper-v4), train the agent\n",
        "- using several λ values and store the training results for comparison.'''\n",
        "\n",
        "# Your code goes here\n",
        "torch.manual_seed(0)\n",
        "T        = 20\n",
        "num_envs = 1\n",
        "\n",
        "# Synthetic rewards and values\n",
        "syn_rewards = torch.rand(T, num_envs)\n",
        "syn_values  = torch.rand(T, num_envs)\n",
        "syn_dones   = torch.zeros(T, num_envs)\n",
        "syn_dones[T - 1, 0] = 1.0               # episode ends at last step\n",
        "syn_next_val = torch.zeros(num_envs)     # bootstrap = 0 (terminal)\n",
        "\n",
        "lambdas = [0.0, 0.3, 0.5, 0.7, 0.9, 1.0]\n",
        "colors  = plt.cm.viridis(np.linspace(0, 1, len(lambdas)))\n",
        "\n",
        "# ── Plot 1: Advantage estimates across timesteps ───────────────────\n",
        "fig, ax = plt.subplots(figsize=(10, 5))\n",
        "for lam, col in zip(lambdas, colors):\n",
        "    adv, _ = compute_gae(syn_rewards, syn_values, syn_dones,\n",
        "                         syn_next_val, gamma=0.99, gae_lambda=lam)\n",
        "    ax.plot(adv[:, 0].numpy(), label=f'λ={lam}', color=col)\n",
        "\n",
        "ax.set_xlabel(\"Timestep\")\n",
        "ax.set_ylabel(\"Advantage Estimate\")\n",
        "ax.set_title(\"GAE Advantage Estimates for Different λ Values\")\n",
        "ax.legend()\n",
        "ax.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"gae_advantage_estimates.pdf\", bbox_inches='tight')\n",
        "plt.show()\n",
        "\n",
        "# ── Plot 2: Bias-Variance trade-off across λ ──────────────────────\n",
        "lambda_sweep = np.linspace(0, 1, 50)\n",
        "variances, mean_abs = [], []\n",
        "\n",
        "for lam in lambda_sweep:\n",
        "    adv, _ = compute_gae(syn_rewards, syn_values, syn_dones,\n",
        "                         syn_next_val, gamma=0.99, gae_lambda=float(lam))\n",
        "    variances.append(adv.var().item())\n",
        "    mean_abs.append(adv.abs().mean().item())\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(8, 5))\n",
        "ax.plot(lambda_sweep, variances,  label='Variance',              color='steelblue', linewidth=2)\n",
        "ax.plot(lambda_sweep, mean_abs,   label='Mean Absolute Advantage', color='darkorange', linewidth=2)\n",
        "ax.set_xlabel(\"λ\")\n",
        "ax.set_ylabel(\"Value\")\n",
        "ax.set_title(\"Bias–Variance Trade-off vs λ\")\n",
        "ax.legend()\n",
        "ax.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"gae_lambda_analysis.pdf\", bbox_inches='tight')\n",
        "plt.show()\n",
        "print(\"Saved gae_lambda_analysis.pdf\")\n",
        "\n"
      ]
    },
