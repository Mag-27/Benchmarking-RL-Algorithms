      "outputs": [],
      "source": [
        "class TD3(TD3):\n",
        "    def trainAgent(self):\n",
        "        #this method collects experiences and trains the agent and does BookKeeping while training.\n",
        "        #this calls the trainNetwork() method internally, it also evaluates the agent per episode\n",
        "        #it trains the agent for MAX_TRAIN_EPISODES\n",
        "        #\n",
        "        #Your code goes in here\n",
        "        #\n",
        "        self.updateValueNetwork(self.onlineValueNetwork1,\n",
        "                                self.targetValueNetwork1, self.tau)\n",
        "        self.updateValueNetwork(self.onlineValueNetwork2,\n",
        "                                self.targetValueNetwork2, self.tau)\n",
        "        self.updatePolicyNetwork(self.onlinePolicyNetwork,\n",
        "                                 self.targetPolicyNetwork, self.tau)\n",
        "\n",
        "        trainRewardsList  = []\n",
        "        trainTimeList     = []\n",
        "        evalRewardsList   = []\n",
        "        wallClockTimeList = []\n",
        "        trainStart        = time.time()\n",
        "\n",
        "        for e in range(self.MAX_TRAIN_EPISODES):\n",
        "            self.episode     = e\n",
        "            epStart          = time.time()\n",
        "            s, _             = self.env.reset()\n",
        "            done             = False\n",
        "            ep_ret           = 0.0\n",
        "            ep_steps         = 0\n",
        "\n",
        "            while not done and ep_steps < 1000:\n",
        "                a = self.gaussianStrategy(\n",
        "                    self.onlinePolicyNetwork, s,\n",
        "                    self.envActionRange, self.noiseScaleRatio,\n",
        "                    explorationMax=(self.rBuffer.length() < self.minSamples))\n",
        "\n",
        "                s_next, r, terminated, truncated, _ = self.env.step(a)\n",
        "                done     = terminated or truncated\n",
        "                ep_steps += 1\n",
        "\n",
        "                self.rBuffer.store(s, a, r, s_next, float(done))\n",
        "                ep_ret += r\n",
        "                s       = s_next\n",
        "\n",
        "                if self.rBuffer.length() > self.minSamples:\n",
        "                    experiences = self.rBuffer.sample(self.batch_size)\n",
        "                    self.trainNetwork(experiences,self.envActionRange)\n",
        "\n",
        "            if e % self.updateFrequencyPolicy == 0:\n",
        "                self.updatePolicyNetwork(self.onlinePolicyNetwork,\n",
        "                                         self.targetPolicyNetwork, self.tau)\n",
        "            if e % self.updateFrequencyValue == 0:\n",
        "                self.updateValueNetwork(self.onlineValueNetwork1,\n",
        "                                        self.targetValueNetwork1, self.tau)\n",
        "                self.updateValueNetwork(self.onlineValueNetwork2,\n",
        "                                        self.targetValueNetwork2, self.tau)\n",
        "\n",
        "            trainTime        = time.time() - epStart\n",
        "            wallClock        = time.time() - trainStart\n",
        "            finalEvalRewards = self.evaluateAgent()\n",
        "            evalMean         = np.mean(finalEvalRewards)\n",
        "\n",
        "            trainRewardsList.append(ep_ret)\n",
        "            trainTimeList.append(trainTime)\n",
        "            evalRewardsList.append(evalMean)\n",
        "            wallClockTimeList.append(wallClock)\n",
        "\n",
        "            print(f\"Ep {e+1}/{self.MAX_TRAIN_EPISODES} | \"\n",
        "                  f\"Train: {ep_ret:.1f} | Eval: {evalMean:.1f} | \"\n",
        "                  f\"Wall: {wallClock:.1f}s\")\n",
        "\n",
        "        return trainRewardsList, trainTimeList, evalRewardsList, wallClockTimeList\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "NUyxuZhlEELg"
      },
      "outputs": [],
      "source": [
        "class TD3(TD3):\n",
        "    def trainNetwork(self,experiences , envActionRange):\n",
        "        # this method trains the value network epoch number of times and is called by the trainAgent function\n",
        "        # it essentially uses the experiences to calculate target, using the targets it calculates the error, which\n",
        "        # is further used for calulating the loss. It then uses the optimizer over the loss\n",
        "        # to update the params of the network by backpropagating through the network\n",
        "        # this function does not return anything\n",
        "        # you can try out other loss functions other than MSE like Huber loss, MAE, etc.\n",
        "        #\n",
        "        #Your code goes in here\n",
        "        #\n",
        "\n",
        "        actionLowVal, actionHighVal = self.envActionRange\n",
        "        ss, acts, rs, sNexts, dones = self.rBuffer.splitExperiences(experiences)\n",
        "\n",
        "        actionLowT  = torch.FloatTensor(actionLowVal)\n",
        "        actionHighT = torch.FloatTensor(actionHighVal)\n",
        "\n",
        "        with torch.no_grad():\n",
        "            as_noise = (actionHighT - actionLowT) * torch.randn_like(acts)\n",
        "            as_noise = torch.max(torch.min(as_noise, actionHighT), actionLowT)\n",
        "\n",
        "            argmax_a_qs_v       = self.targetPolicyNetwork(sNexts)\n",
        "            noisy_argmax_a_qs_v = argmax_a_qs_v + as_noise\n",
        "            noisy_argmax_a_qs_v = torch.max(\n",
        "                torch.min(noisy_argmax_a_qs_v, actionHighT), actionLowT)\n",
        "\n",
        "            max_1_a_qs_v = self.targetValueNetwork1(sNexts, noisy_argmax_a_qs_v)\n",
        "            max_2_a_qs_v = self.targetValueNetwork2(sNexts, noisy_argmax_a_qs_v)\n",
        "            max_a_qs_v   = torch.min(max_1_a_qs_v, max_2_a_qs_v)\n",
        "            target_qs    = rs + self.gamma * max_a_qs_v * (1 - dones)\n",
        "\n",
        "        qs_1 = self.onlineValueNetwork1(ss, acts)\n",
        "        qs_2 = self.onlineValueNetwork2(ss, acts)\n",
        "\n",
        "        tdErrors_1 = target_qs.detach() - qs_1\n",
        "        tdErrors_2 = target_qs.detach() - qs_2\n",
        "\n",
        "        valueLoss = (torch.mean(0.5 * (tdErrors_1) ** 2) +\n",
        "                     torch.mean(0.5 * (tdErrors_2) ** 2))\n",
        "\n",
        "        self.valueOptimizerFn.zero_grad()\n",
        "        valueLoss.backward()\n",
        "        nn.utils.clip_grad_norm_(\n",
        "            list(self.onlineValueNetwork1.parameters()) +\n",
        "            list(self.onlineValueNetwork2.parameters()),\n",
        "            self.maxGradNormValue)\n",
        "        self.valueOptimizerFn.step()\n",
        "\n",
        "        # Delayed policy update — use self.episode tracked in trainAgent\n",
        "        if self.episode % self.trainPolicyFrequency == 0:\n",
        "            argmax_a_qs_p = self.onlinePolicyNetwork(ss)\n",
        "            max_a_qs_p    = self.onlineValueNetwork1(ss, argmax_a_qs_p)\n",
        "            policyLoss    = -1.0 * torch.mean(max_a_qs_p)\n",
        "\n",
        "            self.policyOptimizerFn.zero_grad()\n",
        "            policyLoss.backward()\n",
        "            nn.utils.clip_grad_norm_(self.onlinePolicyNetwork.parameters(),\n",
        "                                     self.maxGradNormPolicy)\n",
        "            self.policyOptimizerFn.step()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "UcNJsS9-EELh"
      },
      "outputs": [],
      "source": [
        "class TD3(TD3):\n",
        "    def evaluateAgent(self):\n",
        "        #this function evaluates the agent using the value network, it evaluates agent for MAX_EVAL_EPISODES\n",
        "        #typcially MAX_EVAL_EPISODES = 1\n",
        "        #\n",
        "        #Your code goes in here\n",
        "        #\n",
        "\n",
        "        rewards = []\n",
        "        for e in range(self.MAX_EVAL_EPISODES):\n",
        "            rs   = 0\n",
        "            s, _ = self.env.reset()\n",
        "            for c in count():\n",
        "                a = self.greedyStrategy(self.onlinePolicyNetwork,\n",
        "                                        s, self.envActionRange)\n",
        "                s, r, terminated, truncated, _ = self.env.step(a)\n",
        "                done = terminated or truncated\n",
        "                rs  += r\n",
        "                if done:\n",
        "                    rewards.append(rs)\n",
        "                    break\n",
        "        finalEvalRewardsList = rewards\n",
        "        return finalEvalRewardsList"
      ]
    },
