        "# Run the A2C training environment and store the results.\n",
        "# Iterate through the environments:'Hopper-v4'.\n",
        "\n",
        "results = {}\n",
        "for env_name in [\"Hopper-v4\"]:\n",
        "    print(f\"\\n{'='*60}\")\n",
        "    print(f\"  Training A2C on {env_name}\")\n",
        "    print(f\"{'='*60}\")\n",
        "    results[env_name] = train_a2c(env_id=env_name,\n",
        "                                  total_timesteps=a2c_total_timesteps)\n",
        "# For each environment, print a header so that the training progress is clear.\n",
        "\n",
        "# Call the function train_a2c() with the environment name and a total training\n",
        "# Store the returned training results in a dictionary.\n",
        "\n",
        "\n",
        "# Plot the learning curve:\n",
        "#   - First plot the raw returns with a light transparency.\n",
        "#   - Then compute a moving-average smoothing using numpy convolution\n",
        "#     to show a cleaner trend of the learning progress.\n",
        "\n",
        "\n",
        "# Display the plot for each environment.\n",
        "def moving_average(data, window=50):\n",
        "    if len(data) < window:\n",
        "        return np.array(data)\n",
        "    return np.convolve(data, np.ones(window) / window, mode='valid')\n",
        "\n",
        "for env_name, rewards in results.items():\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
        "    fig.suptitle(f\"A2C Training — {env_name}\", fontsize=14)\n",
        "\n",
        "    # Raw + smoothed\n",
        "    axes[0].plot(rewards, alpha=0.3, color='steelblue', label='Episode Return')\n",
        "    if len(rewards) >= 50:\n",
        "        axes[0].plot(range(49, len(rewards)),\n",
        "                     moving_average(rewards, 50),\n",
        "                     color='navy', linewidth=2, label='Moving Avg (50)')\n",
        "    axes[0].set_xlabel(\"Episode\")\n",
        "    axes[0].set_ylabel(\"Total Return\")\n",
        "    axes[0].set_title(\"Episode Returns\")\n",
        "    axes[0].legend()\n",
        "    axes[0].grid(True, alpha=0.3)\n",
        "\n",
        "    # Cumulative mean\n",
        "    cum_mean = np.cumsum(rewards) / (np.arange(len(rewards)) + 1)\n",
        "    axes[1].plot(cum_mean, color='darkorange', linewidth=2)\n",
        "    axes[1].set_xlabel(\"Episode\")\n",
        "    axes[1].set_ylabel(\"Cumulative Mean Return\")\n",
        "    axes[1].set_title(\"Cumulative Mean Return\")\n",
        "    axes[1].grid(True, alpha=0.3)\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(f\"a2c_{env_name}_results.png\", dpi=150, bbox_inches='tight')\n",
        "    plt.show()\n",
        "    print(f\"Plot saved for {env_name}.\")"
      ]
    },
