    {
      "cell_type": "markdown",
      "metadata": {
        "id": "B8i83sMKxOYu"
      },
      "source": [
        "## Plot all the graph across on Half Cheetah environment and write an analysis report.\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "tIs24-o8EELh"
      },
      "source": [
        "# PPO [50 marks]\n",
        "<a id=\"PPO\"></a>"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "XcNtFLWJEELh"
      },
      "source": [
        "PPO have quite a few key implementation details.\n",
        "Please Refer:\n",
        "\"Proximal Policy Optimization Algorithms\" [PPO](https://arxiv.org/abs/1707.06347) and\n",
        "\"Implementation Matters in Deep RL: A Case Study on PPO and TRPO\" [Implementation Matters](https://openreview.net/forum?id=r1etN1rtPB)\n",
        "\n",
        "Lets finish things off with an easy implementation of PPO!\n",
        "A easy way to check you implementation details is running your implementation on some easier environment first and make sure it converges."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "yjZ2Gil9EELh"
      },
      "outputs": [],
      "source": [
        "#All imports here\n",
        "## Feel free to add or remove\n",
        "\n",
        "import os\n",
        "import random\n",
        "import time\n",
        "\n",
        "import gymnasium as gym\n",
        "import numpy as np\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "from torch.distributions.categorical import Categorical"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "ItwgNc4nEELh",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "f8717752-9f2c-4c7c-8900-d2ead2f5eefe"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "PPO: batch=512, minibatch=128\n"
          ]
        }
      ],
      "source": [
        "# PPO Hyperparameters (multiprocessing version)\n",
        "\n",
        "ppo_gym_id            = \"HalfCheetah-v4\"\n",
        "ppo_learning_rate     = 2.5e-4\n",
        "ppo_seed              = 1\n",
        "ppo_total_timesteps   = 500000\n",
        "\n",
        "ppo_num_workers       = 4\n",
        "ppo_num_steps         = 128\n",
        "\n",
        "ppo_gamma             = 0.99\n",
        "ppo_gae_lambda        = 0.95\n",
        "\n",
        "ppo_update_epochs     = 4\n",
        "ppo_num_minibatches   = 4\n",
        "\n",
        "ppo_clip_coef         = 0.2\n",
        "ppo_clip_vloss        = True\n",
        "\n",
        "ppo_ent_coef          = 0.01\n",
        "ppo_vf_coef           = 0.5\n",
        "ppo_max_grad_norm     = 0.5\n",
        "\n",
        "ppo_norm_adv          = True\n",
        "ppo_anneal_lr         = True\n",
        "ppo_target_kl         = None\n",
        "\n",
        "ppo_batch_size        = ppo_num_workers * ppo_num_steps\n",
        "ppo_minibatch_size    = ppo_batch_size // ppo_num_minibatches\n",
        "print(f\"PPO: batch={ppo_batch_size}, minibatch={ppo_minibatch_size}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "1d2sqcdqEELh"
      },
      "outputs": [],
      "source": [
        "# PPO Agent (takes raw dims, works in any process)\n",
        "class PPOAgent(nn.Module):\n",
        "    \"\"\"\n",
        "    PPO agent containing separate actor and critic networks.\n",
        "    Supports both discrete and continuous action spaces.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, obs_dim, act_dim, is_discrete=False,\n",
        "                 action_high=None, action_low=None):\n",
        "        \"\"\"\n",
        "        Initialize the PPO agent.\n",
        "\n",
        "        Args:\n",
        "            obs_dim (int): Dimension of the observation/state space.\n",
        "            act_dim (int): Dimension of the action space.\n",
        "            is_discrete (bool): True if the environment has a discrete\n",
        "                                action space, otherwise False.\n",
        "            action_high (array-like, optional): Upper bound of the\n",
        "                                continuous action space.\n",
        "            action_low (array-like, optional): Lower bound of the\n",
        "                                continuous action space.\n",
        "\n",
        "        Expected Output:\n",
        "            Initializes actor and critic neural networks along with\n",
        "            parameters required for action scaling in continuous spaces.\n",
        "        \"\"\"\n",
        "\n",
        "\n",
        "        #Your Code goes here\n",
        "        super(PPOAgent, self).__init__()\n",
        "        self.is_discrete  = is_discrete\n",
        "        self.action_high  = action_high\n",
        "        self.action_low   = action_low\n",
        "\n",
        "        self.critic = nn.Sequential(\n",
        "            nn.Linear(obs_dim, 64), nn.Tanh(),\n",
        "            nn.Linear(64, 64),      nn.Tanh(),\n",
        "            nn.Linear(64, 1)\n",
        "        )\n",
        "\n",
        "        if is_discrete:\n",
        "            self.actor = nn.Sequential(\n",
        "                nn.Linear(obs_dim, 64), nn.Tanh(),\n",
        "                nn.Linear(64, 64),      nn.Tanh(),\n",
        "                nn.Linear(64, act_dim)\n",
        "            )\n",
        "        else:\n",
        "            self.actor_mean = nn.Sequential(\n",
        "                nn.Linear(obs_dim, 64), nn.Tanh(),\n",
        "                nn.Linear(64, 64),      nn.Tanh(),\n",
        "                nn.Linear(64, act_dim)\n",
        "            )\n",
        "            self.actor_log_std = nn.Parameter(torch.zeros(act_dim))\n",
        "\n",
        "    def get_value(self, x):\n",
        "      \"\"\"\n",
        "      Compute the value estimate for a given state.\n",
        "\n",
        "      Args:\n",
        "          x (Tensor): Input state tensor of shape (batch_size, obs_dim).\n",
        "\n",
        "      Expected Output:\n",
        "          Tensor containing the predicted state value V(s)\n",
        "          from the critic network.\n",
        "      \"\"\"\n",
        "      return self.critic(x)\n",
        "\n",
        "\n",
        "\n",
        "    def get_action_and_value(self, x, action=None):\n",
        "        \"\"\"\n",
        "        Compute action, log probability, entropy, and state value.\n",
        "\n",
        "        Args:\n",
        "            x (Tensor): Input state tensor of shape (batch_size, obs_dim).\n",
        "            action (Tensor, optional): Specific action for which the\n",
        "                                       log probability should be computed.\n",
        "                                       If None, the function samples an action\n",
        "                                       from the policy distribution.\n",
        "\n",
        "        Expected Output:\n",
        "            action (Tensor): Sampled or provided action.\n",
        "            log_prob (Tensor): Log probability of the selected action.\n",
        "            entropy (Tensor): Entropy of the action distribution\n",
        "                              (used for exploration).\n",
        "            value (Tensor): Predicted state value from the critic.\n",
        "        \"\"\"\n",
        "        if self.is_discrete:\n",
        "            logits = self.actor(x)\n",
        "            dist   = Categorical(logits=logits)\n",
        "            if action is None:\n",
        "                action = dist.sample()\n",
        "            return action, dist.log_prob(action), dist.entropy(), self.critic(x)\n",
        "        else:\n",
        "            mean    = self.actor_mean(x)\n",
        "            log_std = self.actor_log_std.expand_as(mean)\n",
        "            std     = torch.exp(log_std)\n",
        "            dist    = torch.distributions.Normal(mean, std)\n",
        "            if action is None:\n",
        "                action = dist.sample()\n",
        "            log_prob = dist.log_prob(action).sum(dim=-1)\n",
        "            entropy  = dist.entropy().sum(dim=-1)\n",
        "            return action, log_prob, entropy, self.critic(x)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "7AcdVSY-uldh"
      },
      "outputs": [],
      "source": [
        "# PPO Worker + Training Loop (Multiprocessing Version)\n",
        "def ppo_worker(worker_id, global_agent,\n",
        "               env_id, seed, num_steps, num_updates,\n",
        "               shared_obs, shared_actions, shared_logprobs,\n",
        "               shared_rewards, shared_dones, shared_values,\n",
        "               shared_next_obs, shared_next_done,\n",
        "               collect_barrier, update_barrier, ep_queue):\n",
        "    \"\"\"\n",
        "    PPO worker process responsible for collecting rollouts.\n",
        "\n",
        "    Args:\n",
        "        worker_id        : Unique ID of the worker process.\n",
        "        global_agent     : Shared PPO policy network.\n",
        "        env_id           : Gym environment name.\n",
        "        seed             : Random seed for reproducibility.\n",
        "        num_steps        : Number of steps collected per rollout.\n",
        "        num_updates      : Number of PPO updates to perform.\n",
        "\n",
        "        shared_obs       : Shared buffer storing observations.\n",
        "        shared_actions   : Shared buffer storing actions.\n",
        "        shared_logprobs  : Shared buffer storing log probabilities.\n",
        "        shared_rewards   : Shared buffer storing rewards.\n",
        "        shared_dones     : Shared buffer storing termination flags.\n",
        "        shared_values    : Shared buffer storing value predictions.\n",
        "\n",
        "        shared_next_obs  : Shared buffer storing next observations.\n",
        "        shared_next_done : Shared buffer storing next done flag.\n",
        "\n",
        "        collect_barrier  : Synchronization barrier for rollout collection.\n",
        "        update_barrier   : Synchronization barrier after PPO update.\n",
        "        ep_queue         : Queue used to send episode rewards to main process.\n",
        "\n",
        "    Expected Output:\n",
        "        This function does not return values directly.\n",
        "        Instead, it stores rollout data in shared buffers and\n",
        "        sends episode rewards to the main process through ep_queue.\n",
        "    \"\"\"\n",
        "    env = gym.make(env_id)\n",
        "    env.action_space.seed(seed + worker_id)\n",
        "    obs, _ = env.reset(seed=seed + worker_id)\n",
        "\n",
        "    ep_reward = 0.0\n",
        "\n",
        "    for update in range(num_updates):\n",
        "\n",
        "        for step in range(num_steps):\n",
        "            shared_obs[worker_id, step] = torch.FloatTensor(obs)\n",
        "\n",
        "            with torch.no_grad():\n",
        "                obs_t  = torch.FloatTensor(obs).unsqueeze(0)\n",
        "                action, logprob, _, value = global_agent.get_action_and_value(obs_t)\n",
        "\n",
        "            action_np = action.squeeze(0).numpy()\n",
        "            shared_actions[worker_id, step] = action.squeeze(0)\n",
        "            shared_logprobs[worker_id, step]  = logprob\n",
        "            shared_values[worker_id, step]    = value.squeeze()\n",
        "\n",
        "            obs, reward, terminated, truncated, _ = env.step(action_np)\n",
        "            done = terminated or truncated\n",
        "            shared_rewards[worker_id, step] = reward\n",
        "            shared_dones[worker_id, step]   = float(done)\n",
        "            ep_reward += reward\n",
        "\n",
        "            if done:\n",
        "                ep_queue.put((worker_id, ep_reward))\n",
        "                ep_reward = 0.0\n",
        "                obs, _ = env.reset()\n",
        "\n",
        "        shared_next_obs[worker_id]  = torch.FloatTensor(obs)\n",
        "        shared_next_done[worker_id] = float(done)\n",
        "\n",
        "\n",
        "        collect_barrier.wait()\n",
        "\n",
        "\n",
        "        update_barrier.wait()\n",
        "\n",
        "    env.close()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "Ncrl10fAu3Lm"
      },
      "outputs": [],
      "source": [
        "def train_ppo(env_id=ppo_gym_id, seed=ppo_seed,\n",
        "              total_timesteps=ppo_total_timesteps,\n",
        "              num_workers=ppo_num_workers, num_steps=ppo_num_steps,\n",
        "              lr=ppo_learning_rate, gamma=ppo_gamma,\n",
        "              gae_lambda=ppo_gae_lambda, update_epochs=ppo_update_epochs,\n",
        "              num_minibatches=ppo_num_minibatches,\n",
        "              clip_coef=ppo_clip_coef, clip_vloss=ppo_clip_vloss,\n",
        "              ent_coef=ppo_ent_coef, vf_coef=ppo_vf_coef,\n",
        "              max_grad_norm=ppo_max_grad_norm, norm_adv=ppo_norm_adv,\n",
        "              anneal_lr=ppo_anneal_lr, target_kl=ppo_target_kl):\n",
        "    \"\"\"\n",
        "    PPO training loop using multiprocessing workers.\n",
        "\n",
        "    Args:\n",
        "        env_id           : Gym environment used for training.\n",
        "        seed             : Random seed.\n",
        "        total_timesteps  : Total number of environment interactions.\n",
        "        num_workers      : Number of parallel workers collecting data.\n",
        "        num_steps        : Number of rollout steps per worker.\n",
        "\n",
        "        lr               : Learning rate for optimizer.\n",
        "        gamma            : Discount factor for future rewards.\n",
        "        gae_lambda       : Lambda parameter for GAE.\n",
        "\n",
        "        update_epochs    : Number of PPO update passes per batch.\n",
        "        num_minibatches  : Number of minibatches for SGD.\n",
        "\n",
        "        clip_coef        : PPO clipping coefficient.\n",
        "        clip_vloss       : Whether value loss clipping is used.\n",
        "\n",
        "        ent_coef         : Entropy coefficient for exploration.\n",
        "        vf_coef          : Value loss coefficient.\n",
        "        max_grad_norm    : Maximum gradient norm for clipping.\n",
        "\n",
        "        norm_adv         : Whether to normalize advantages.\n",
        "        anneal_lr        : Whether learning rate is annealed.\n",
        "        target_kl        : Optional KL divergence stopping threshold.\n",
        "\n",
        "    Expected Output:\n",
        "        results      : List containing tuples (global_step, episode_reward)\n",
        "                       used to plot the learning curve.\n",
        "        global_agent : The trained PPO agent.\n",
        "    \"\"\"\n",
        "    torch.manual_seed(seed)\n",
        "    np.random.seed(seed)\n",
        "    random.seed(seed)\n",
        "\n",
        "\n",
        "    tmp_env  = gym.make(env_id)\n",
        "    obs_dim  = tmp_env.observation_space.shape[0]\n",
        "    is_discrete = isinstance(tmp_env.action_space, gym.spaces.Discrete)\n",
        "    act_dim  = tmp_env.action_space.n if is_discrete else tmp_env.action_space.shape[0]\n",
        "    tmp_env.close()\n",
        "\n",
        "    batch_size     = num_workers * num_steps\n",
        "    minibatch_size = batch_size // num_minibatches\n",
        "    num_updates    = total_timesteps // batch_size\n",
        "\n",
        "    global_agent = PPOAgent(obs_dim, act_dim, is_discrete=is_discrete)\n",
        "    global_agent.share_memory()\n",
        "    optimizer = optim.Adam(global_agent.parameters(), lr=lr, eps=1e-5)\n",
        "\n",
        "\n",
        "    shared_obs      = torch.zeros(num_workers, num_steps, obs_dim).share_memory_()\n",
        "    shared_actions  = torch.zeros(num_workers, num_steps, act_dim).share_memory_()\n",
        "    shared_logprobs = torch.zeros(num_workers, num_steps).share_memory_()\n",
        "    shared_rewards  = torch.zeros(num_workers, num_steps).share_memory_()\n",
        "    shared_dones    = torch.zeros(num_workers, num_steps).share_memory_()\n",
        "    shared_values   = torch.zeros(num_workers, num_steps).share_memory_()\n",
        "    shared_next_obs  = torch.zeros(num_workers, obs_dim).share_memory_()\n",
        "    shared_next_done = torch.zeros(num_workers).share_memory_()\n",
        "\n",
        "    collect_barrier = mp.Barrier(num_workers + 1)\n",
        "    update_barrier  = mp.Barrier(num_workers + 1)\n",
        "    ep_queue        = mp.Queue()\n",
        "\n",
        "    # ── start workers ──\n",
        "    workers = []\n",
        "    for wid in range(num_workers):\n",
        "        p = mp.Process(target=ppo_worker, args=(\n",
        "            wid, global_agent, env_id, seed,\n",
        "            num_steps, num_updates,\n",
        "            shared_obs, shared_actions, shared_logprobs,\n",
        "            shared_rewards, shared_dones, shared_values,\n",
        "            shared_next_obs, shared_next_done,\n",
        "            collect_barrier, update_barrier, ep_queue\n",
        "        ))\n",
        "        p.start()\n",
        "        workers.append(p)\n",
        "\n",
        "    results      = []\n",
        "    global_step  = 0\n",
        "\n",
        "    for update in range(1, num_updates + 1):\n",
        "\n",
        "        # anneal lr\n",
        "        if anneal_lr:\n",
        "            frac = 1.0 - (update - 1.0) / num_updates\n",
        "            optimizer.param_groups[0]['lr'] = frac * lr\n",
        "\n",
        "\n",
        "        collect_barrier.wait()\n",
        "        global_step += batch_size\n",
        "\n",
        "        while not ep_queue.empty():\n",
        "            wid, ep_r = ep_queue.get_nowait()\n",
        "            results.append((global_step, ep_r))\n",
        "            print(f\"  global_step={global_step}, ep_reward={ep_r:.2f}\")\n",
        "\n",
        "        obs_b      = shared_obs.reshape(-1, obs_dim)\n",
        "        actions_b  = shared_actions.reshape(-1, act_dim)\n",
        "        logprobs_b = shared_logprobs.reshape(-1)\n",
        "        rewards_b  = shared_rewards.reshape(-1)\n",
        "        dones_b    = shared_dones.reshape(-1)\n",
        "        values_b   = shared_values.reshape(-1)\n",
        "\n",
        "        with torch.no_grad():\n",
        "            next_values = global_agent.get_value(shared_next_obs).squeeze(-1)\n",
        "            advantages  = torch.zeros_like(rewards_b)\n",
        "            lastgaelam  = 0\n",
        "            for t in reversed(range(batch_size)):\n",
        "                wi   = t // num_steps\n",
        "                step = t %  num_steps\n",
        "                if step == num_steps - 1:\n",
        "                    nextnonterminal = 1.0 - shared_next_done[wi]\n",
        "                    nextvalue       = next_values[wi]\n",
        "                else:\n",
        "                    nextnonterminal = 1.0 - shared_dones[wi, step + 1]\n",
        "                    nextvalue       = shared_values[wi, step + 1]\n",
        "                delta      = rewards_b[t] + gamma * nextvalue * nextnonterminal - values_b[t]\n",
        "                advantages[t] = lastgaelam = delta + gamma * gae_lambda * nextnonterminal * lastgaelam\n",
        "            returns_b = advantages + values_b\n",
        "\n",
        "        b_inds = np.arange(batch_size)\n",
        "        for epoch in range(update_epochs):\n",
        "            np.random.shuffle(b_inds)\n",
        "            for start in range(0, batch_size, minibatch_size):\n",
        "                end  = start + minibatch_size\n",
        "                mb   = b_inds[start:end]\n",
        "\n",
        "                _, newlogprob, entropy, newvalue = global_agent.get_action_and_value(\n",
        "                    obs_b[mb], actions_b[mb]\n",
        "                )\n",
        "\n",
        "                logratio  = newlogprob - logprobs_b[mb]\n",
        "                ratio     = logratio.exp()\n",
        "\n",
        "                mb_adv = advantages[mb]\n",
        "                if norm_adv:\n",
        "                    mb_adv = (mb_adv - mb_adv.mean()) / (mb_adv.std() + 1e-8)\n",
        "\n",
        "                pg_loss1 = -mb_adv * ratio\n",
        "                pg_loss2 = -mb_adv * torch.clamp(ratio, 1 - clip_coef, 1 + clip_coef)\n",
        "                pg_loss  = torch.max(pg_loss1, pg_loss2).mean()\n",
        "\n",
        "                newvalue = newvalue.squeeze()\n",
        "                if clip_vloss:\n",
        "                    v_loss_unclipped = (newvalue - returns_b[mb]) ** 2\n",
        "                    v_clipped        = values_b[mb] + torch.clamp(\n",
        "                        newvalue - values_b[mb], -clip_coef, clip_coef)\n",
        "                    v_loss_clipped   = (v_clipped - returns_b[mb]) ** 2\n",
        "                    v_loss           = 0.5 * torch.max(v_loss_unclipped, v_loss_clipped).mean()\n",
        "                else:\n",
        "                    v_loss = 0.5 * ((newvalue - returns_b[mb]) ** 2).mean()\n",
        "\n",
        "                entropy_loss = entropy.mean()\n",
        "                loss         = pg_loss - ent_coef * entropy_loss + vf_coef * v_loss\n",
        "\n",
        "                optimizer.zero_grad()\n",
        "                loss.backward()\n",
        "                nn.utils.clip_grad_norm_(global_agent.parameters(), max_grad_norm)\n",
        "                optimizer.step()\n",
        "\n",
        "            if target_kl is not None:\n",
        "                with torch.no_grad():\n",
        "                    _, newlogprob_all, _, _ = global_agent.get_action_and_value(obs_b, actions_b)\n",
        "                    kl = (logprobs_b - newlogprob_all).mean()\n",
        "                    if kl > target_kl:\n",
        "                        break\n",
        "\n",
        "\n",
        "        update_barrier.wait()\n",
        "\n",
        "    for p in workers:\n",
        "        p.join()\n",
        "\n",
        "    return results, global_agent"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "results, trained_agent = train_ppo(\n",
        "    env_id           = \"HalfCheetah-v4\",\n",
        "    seed             = 1,\n",
        "    total_timesteps  = 1_000_000,\n",
        "    num_workers      = 4,\n",
        "    num_steps        = 2048,\n",
        "    lr               = 3e-4,\n",
        "    gamma            = 0.99,\n",
        "    gae_lambda       = 0.95,\n",
        "    update_epochs    = 10,\n",
        "    num_minibatches  = 32,\n",
        "    clip_coef        = 0.2,\n",
        "    clip_vloss       = True,\n",
        "    ent_coef         = 0.0,\n",
        "    vf_coef          = 0.5,\n",
        "    max_grad_norm    = 0.5,\n",
        "    norm_adv         = True,\n",
        "    anneal_lr        = True,\n",
        "    target_kl        = 0.01\n",
        ")\n",
        "\n",
        "# ── Plot ──\n",
        "steps   = [r[0] for r in results]\n",
        "rewards = [r[1] for r in results]\n",
        "\n",
        "# smoothing helper\n",
        "def smooth(y, window=20):\n",
        "    if len(y) < window:\n",
        "        return y\n",
        "    return np.convolve(y, np.ones(window)/window, mode='valid')\n",
        "\n",
        "smoothed_rewards = smooth(rewards)\n",
        "smoothed_steps   = steps[:len(smoothed_rewards)]\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "plt.plot(steps, rewards, alpha=0.3, color='steelblue', label='Episode Reward')\n",
        "plt.plot(smoothed_steps, smoothed_rewards, color='steelblue', linewidth=2, label=f'Smoothed (window=20)')\n",
        "plt.xlabel('Global Step')\n",
        "plt.ylabel('Episode Reward')\n",
        "plt.title('PPO on HalfCheetah-v4')\n",
        "plt.legend()\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(f\"\\nTotal episodes  : {len(rewards)}\")\n",
        "print(f\"Final mean reward (last 20): {np.mean(rewards[-20:]):.2f}\")\n",
        "print(f\"Best episode reward        : {max(rewards):.2f}\")"
      ],
