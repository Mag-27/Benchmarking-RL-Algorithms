    {
      "cell_type": "code",
      "source": [
        "# ======================================================================\n",
        "# SharedAdam: Adam optimizer with shared state across processes\n",
        "# ======================================================================\n",
        "# Standard Adam stores its internal state (moment estimates) per-process.\n",
        "# For A3C, we need the optimizer state to be in shared memory so that\n",
        "# all worker processes update the same momentum buffers.\n",
        "\n",
        "class SharedAdam(optim.Adam):\n",
        "\n",
        "    def __init__(self, params, lr=1e-3, betas=(0.9, 0.999), eps=1e-8):\n",
        "        super().__init__(params, lr=lr, betas=betas, eps=eps)\n",
        "        # Move optimizer state to shared memory\n",
        "        for group in self.param_groups:\n",
        "            for param in group['params']:\n",
        "                self.state[param]['step'] = torch.zeros(1).share_memory_()  # must be tensor now\n",
        "                self.state[param]['exp_avg'] = torch.zeros_like(param.data).share_memory_()\n",
        "                self.state[param]['exp_avg_sq'] = torch.zeros_like(param.data).share_memory_()\n",
        "\n",
        "    def step(self, closure=None):\n",
        "        for group in self.param_groups:\n",
        "            for param in group['params']:\n",
        "                if param.grad is None:\n",
        "                    continue\n",
        "                self.state[param]['step'] += 1   # increment tensor in-place\n",
        "        super().step(closure)"
      ],
      "metadata": {
        "id": "YQD8aCeHGT6e"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# ==============================================================\n",
        "# A3C Agent\n",
        "# ==============================================================\n",
        "\n",
        "class A3CAgent(nn.Module):\n",
        "    \"\"\"\n",
        "    A3C agent with separate actor and critic networks.\n",
        "    Supports both discrete and continuous action spaces.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, obs_dim, act_dim, is_discrete=False):\n",
        "        \"\"\"\n",
        "        Initialize actor and critic networks.\n",
        "        obs_dim     : Dimension of observation space\n",
        "        act_dim     : Dimension of action space\n",
        "        is_discrete : Whether the action space is discrete\n",
        "        \"\"\"\n",
        "\n",
        "        # Your code goes here\n",
        "        super().__init__()\n",
        "        self.is_discrete = is_discrete\n",
        "\n",
        "        # Actor network\n",
        "        self.actor = nn.Sequential(\n",
        "            nn.Linear(obs_dim, 256),\n",
        "            nn.Tanh(),\n",
        "            nn.Linear(256, 256),\n",
        "            nn.Tanh(),\n",
        "            nn.Linear(256, act_dim)\n",
        "        )\n",
        "\n",
        "        # Critic network\n",
        "        self.critic = nn.Sequential(\n",
        "            nn.Linear(obs_dim, 256),\n",
        "            nn.Tanh(),\n",
        "            nn.Linear(256, 256),\n",
        "            nn.Tanh(),\n",
        "            nn.Linear(256, 1)\n",
        "        )\n",
        "\n",
        "        if not is_discrete:\n",
        "            # Learnable log std for continuous actions\n",
        "            self.log_std = nn.Parameter(torch.zeros(act_dim))\n",
        "\n",
        "    def get_value(self, x):\n",
        "        \"\"\"\n",
        "        Return the value estimate for a given state using the critic.\n",
        "        \"\"\"\n",
        "        return self.critic(x)\n",
        "\n",
        "    def get_action_and_value(self, x, action=None):\n",
        "        \"\"\"\n",
        "        Compute action, log probability, entropy, and value.\n",
        "\n",
        "        For discrete actions:\n",
        "            create a categorical distribution from actor logits.\n",
        "\n",
        "        For continuous actions:\n",
        "            create a normal distribution using mean and std.\n",
        "\n",
        "        If action is None, sample from the distribution.\n",
        "        Return action, log probability, entropy, and value.\n",
        "        \"\"\"\n",
        "        if self.is_discrete:\n",
        "            logits = self.actor(x)\n",
        "            dist = torch.distributions.Categorical(logits=logits)\n",
        "        else:\n",
        "            mean = self.actor(x)\n",
        "            std = self.log_std.exp().expand_as(mean)\n",
        "            dist = torch.distributions.Normal(mean, std)\n",
        "\n",
        "        if action is None:\n",
        "            action = dist.sample()\n",
        "\n",
        "        log_prob = dist.log_prob(action)\n",
        "        if not self.is_discrete:\n",
        "            log_prob = log_prob.sum(-1)\n",
        "\n",
        "        entropy = dist.entropy()\n",
        "        if not self.is_discrete:\n",
        "            entropy = entropy.sum(-1)\n",
        "\n",
        "        value = self.critic(x)\n",
        "        return action, log_prob, entropy, value"
      ],
      "metadata": {
        "id": "nAGP-gDqGqSi"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "# A3C Worker (truly parallel via torch.multiprocessing)\n",
        "\n",
        "\n",
        "def a3c_worker(worker_id, global_agent, global_optimizer, grad_lock,\n",
        "               env_id, seed, num_episodes,\n",
        "               gamma, num_steps, ent_coef, vf_coef, max_grad_norm,\n",
        "               result_queue):\n",
        "    \"\"\"\n",
        "    A3C worker — runs as a separate OS process.\n",
        "\n",
        "    Each worker independently:\n",
        "      1. Syncs local weights from the shared global network.\n",
        "      2. Collects a rollout of num_steps transitions.\n",
        "      3. Computes n-step returns and advantage.\n",
        "      4. Computes gradients on its LOCAL network copy.\n",
        "      5. Pushes those gradients to the GLOBAL network (under lock).\n",
        "      6. Sends episode reward to main process via result_queue.\n",
        "\n",
        "    The grad_lock serialises gradient push + optimizer.step() to prevent\n",
        "    two workers from corrupting each other's gradients.\n",
        "    \"\"\"\n",
        "    env = gym.make(env_id)\n",
        "    torch.manual_seed(seed + worker_id)\n",
        "\n",
        "    obs_dim = env.observation_space.shape[0]\n",
        "    act_dim = env.action_space.shape[0]\n",
        "    is_discrete = isinstance(env.action_space, gym.spaces.Discrete)\n",
        "\n",
        "    # Local network copy\n",
        "    local_agent = A3CAgent(obs_dim, act_dim, is_discrete)\n",
        "\n",
        "    for episode in range(num_episodes):\n",
        "        # 1. Sync local weights from global\n",
        "        local_agent.load_state_dict(global_agent.state_dict())\n",
        "\n",
        "        s, _ = env.reset(seed=seed + worker_id + episode)\n",
        "        done = False\n",
        "        episode_reward = 0\n",
        "        steps = 0\n",
        "\n",
        "        while not done:\n",
        "            rewards, log_probs, entropies, values = [], [], [], []\n",
        "            n_steps_taken = 0\n",
        "\n",
        "            # 2. Collect rollout of num_steps transitions\n",
        "            for _ in range(num_steps):\n",
        "                s_tensor = torch.FloatTensor(s).unsqueeze(0)\n",
        "                action, log_prob, entropy, value = local_agent.get_action_and_value(s_tensor)\n",
        "\n",
        "                a = action.squeeze(0).detach().numpy()\n",
        "                s_next, r, terminated, truncated, _ = env.step(a)\n",
        "                done = terminated or truncated\n",
        "\n",
        "                rewards.append(r)\n",
        "                log_probs.append(log_prob)\n",
        "                entropies.append(entropy)\n",
        "                values.append(value)\n",
        "\n",
        "                episode_reward += r\n",
        "                steps += 1\n",
        "                n_steps_taken += 1\n",
        "                s = s_next\n",
        "\n",
        "                if done:\n",
        "                    break\n",
        "\n",
        "            # 3. Compute n-step returns (bootstrap if not done)\n",
        "            if done:\n",
        "                R = 0.0\n",
        "            else:\n",
        "                with torch.no_grad():\n",
        "                    s_tensor = torch.FloatTensor(s).unsqueeze(0)\n",
        "                    R = local_agent.get_value(s_tensor).item()\n",
        "\n",
        "            returns = []\n",
        "            gammas_list = []\n",
        "            gamma_t = 1.0\n",
        "            for i in range(n_steps_taken - 1, -1, -1):\n",
        "                R = rewards[i] + gamma * R\n",
        "                returns.insert(0, R)\n",
        "                gammas_list.insert(0, gamma_t)\n",
        "                gamma_t *= gamma\n",
        "\n",
        "            returns = torch.FloatTensor(returns)\n",
        "            gammas_tensor = torch.FloatTensor(gammas_list)\n",
        "            values_tensor = torch.cat(values).squeeze(-1)\n",
        "            log_probs_tensor = torch.stack(log_probs).squeeze(-1)\n",
        "            entropies_tensor = torch.stack(entropies).squeeze(-1)\n",
        "\n",
        "            # 4. Compute advantages (deltas)\n",
        "            deltas = returns - values_tensor.detach()\n",
        "\n",
        "            # Policy loss (as in slides: mean(-gammas * deltas * logProbs))\n",
        "            p_loss = torch.mean(-gammas_tensor * deltas.detach() * log_probs_tensor)\n",
        "            entropy_loss = -torch.mean(entropies_tensor)\n",
        "            policy_loss = p_loss + ent_coef * entropy_loss\n",
        "\n",
        "            # Value loss\n",
        "            value_loss = torch.mean(0.5 * (deltas ** 2))\n",
        "\n",
        "            total_loss = policy_loss + vf_coef * value_loss\n",
        "\n",
        "            # 5. Compute gradients on LOCAL network\n",
        "            global_optimizer.zero_grad()\n",
        "            total_loss.backward()\n",
        "            nn.utils.clip_grad_norm_(local_agent.parameters(), max_grad_norm)\n",
        "\n",
        "            # 6. Push gradients to GLOBAL network (under lock)\n",
        "            with grad_lock:\n",
        "              for local_p, global_p in zip(local_agent.parameters(), global_agent.parameters()):\n",
        "                  if local_p.grad is None:          # <-- add this check\n",
        "                      continue\n",
        "                  if global_p.grad is None:\n",
        "                      global_p._grad = local_p.grad.clone()\n",
        "                  else:\n",
        "                      global_p._grad += local_p.grad.clone()\n",
        "              global_optimizer.step()\n",
        "\n",
        "            # Re-sync local from global after update\n",
        "            local_agent.load_state_dict(global_agent.state_dict())\n",
        "\n",
        "        result_queue.put((worker_id, episode_reward))\n",
        "\n",
        "    env.close()"
      ],
      "metadata": {
        "id": "fcf5YJsbGxXc"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# A3C Laucher — spawns truly parallel worker processes\n",
        "\n",
        "def train_a3c(env_id=a3c_gym_id, seed=1, num_workers=a3c_num_workers,\n",
        "              episodes_per_worker=500,\n",
        "              gamma=a3c_gamma, num_steps=a3c_num_steps, lr=a3c_learning_rate,\n",
        "              ent_coef=a3c_ent_coef, vf_coef=a3c_vf_coef,\n",
        "              max_grad_norm=a3c_max_grad_norm):\n",
        "    \"\"\"\n",
        "    Launches A3C training with truly parallel worker processes.\n",
        "\n",
        "    1. Creates global_agent in shared memory.\n",
        "    2. Creates SharedAdam (optimizer state also in shared memory).\n",
        "    3. Creates mp.Lock for gradient push serialisation.\n",
        "    4. Spawns num_workers mp.Process instances (all start simultaneously).\n",
        "    5. Main process collects rewards from Queue while workers train.\n",
        "    6. p.join() waits for all workers to finish.\n",
        "    \"\"\"\n",
        "\n",
        "    # Your code goes here\n",
        "    mp.set_start_method('fork', force=True)\n",
        "\n",
        "    env = gym.make(env_id)\n",
        "    obs_dim = env.observation_space.shape[0]\n",
        "    act_dim = env.action_space.shape[0]\n",
        "    is_discrete = isinstance(env.action_space, gym.spaces.Discrete)\n",
        "    env.close()\n",
        "\n",
        "    # 1. Global agent in shared memory\n",
        "    global_agent = A3CAgent(obs_dim, act_dim, is_discrete)\n",
        "    global_agent.share_memory()\n",
        "\n",
        "    # 2. SharedAdam with state in shared memory\n",
        "    global_optimizer = SharedAdam(global_agent.parameters(), lr=lr)\n",
        "\n",
        "    # 3. Lock for gradient push serialisation\n",
        "    grad_lock = mp.Lock()\n",
        "\n",
        "    # 4. Queue for collecting rewards from workers\n",
        "    result_queue = mp.Queue()\n",
        "\n",
        "    # 5. Spawn workers (all start simultaneously)\n",
        "    processes = []\n",
        "    for worker_id in range(num_workers):\n",
        "        p = mp.Process(\n",
        "            target=a3c_worker,\n",
        "            args=(worker_id, global_agent, global_optimizer, grad_lock,\n",
        "                  env_id, seed, episodes_per_worker,\n",
        "                  gamma, num_steps, ent_coef, vf_coef, max_grad_norm,\n",
        "                  result_queue)\n",
        "        )\n",
        "        p.start()\n",
        "        processes.append(p)\n",
        "\n",
        "    # 6. Collect rewards from queue while workers train\n",
        "    all_rewards = []\n",
        "    total_expected = num_workers * episodes_per_worker\n",
        "    received = 0\n",
        "\n",
        "    while received < total_expected:\n",
        "        try:\n",
        "            worker_id, ep_reward = result_queue.get(timeout=120)\n",
        "            all_rewards.append(ep_reward)\n",
        "            received += 1\n",
        "            if received % 50 == 0:\n",
        "                print(f\"Episodes done: {received}/{total_expected} | \"\n",
        "                      f\"Recent mean reward: {np.mean(all_rewards[-50:]):.2f}\")\n",
        "        except Empty:\n",
        "            # Check if all processes are still alive\n",
        "            if not any(p.is_alive() for p in processes):\n",
        "                break\n",
        "\n",
        "    for p in processes:\n",
        "        p.join()\n",
        "\n",
        "    print(f\"\\nTraining complete. Total episodes: {len(all_rewards)}\")\n",
        "    return all_rewards"
      ],
      "metadata": {
        "id": "KmY-pC7VG_u8"
      },
