      "source": [
        "ddpg_all_train    = []\n",
        "ddpg_all_eval     = []\n",
        "ddpg_all_steps    = []\n",
        "ddpg_all_train_t  = []\n",
        "ddpg_all_wall_t   = []\n",
        "\n",
        "for seed in range(5):\n",
        "    print(f\"\\n=== DDPG Seed {seed} ===\")\n",
        "    env = gym.make(\"HalfCheetah-v4\")\n",
        "    agent = DDPG(\n",
        "        env                = env,\n",
        "        seed               = seed,\n",
        "        gamma              = 0.98,\n",
        "        tau                = 0.008,\n",
        "        bufferSize         = 100_000,\n",
        "        batch_size         = 256,\n",
        "        updateFrequency    = 1,\n",
        "        policyOptimizerFn  = optim.Adam,\n",
        "        valueOptimizerFn   = optim.Adam,\n",
        "        policyOptimizerLR  = 1e-4,\n",
        "        valueOptimizerLR   = 1e-3,\n",
        "        MAX_TRAIN_EPISODES = 1000,\n",
        "        MAX_EVAL_EPISODE   = 1,\n",
        "        optimizerFn        = optim.Adam\n",
        "    )\n",
        "    trainR, trainT, evalR, wallT, _ = agent.runDDPG()\n",
        "    env.close()\n",
        "\n",
        "    ddpg_all_train.append(trainR)\n",
        "    ddpg_all_eval.append(evalR)\n",
        "    ddpg_all_train_t.append(trainT)\n",
        "    ddpg_all_wall_t.append(wallT)\n",
        "    # cumulative steps per episode (each ep is max 1000 steps)\n",
        "    steps = np.cumsum([min(len(trainR), 1000)] * len(trainR))\n",
        "    ddpg_all_steps.append(steps.tolist())\n",
        "\n",
        "ddpg_all_train   = np.array(ddpg_all_train)\n",
        "ddpg_all_eval    = np.array(ddpg_all_eval)\n",
        "ddpg_all_steps   = np.array(ddpg_all_steps)\n",
        "ddpg_all_train_t = np.array(ddpg_all_train_t)\n",
        "ddpg_all_wall_t  = np.array(ddpg_all_wall_t)\n",
        "print(\"DDPG done.\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "td3_all_train    = []\n",
        "td3_all_eval     = []\n",
        "td3_all_steps    = []\n",
        "td3_all_train_t  = []\n",
        "td3_all_wall_t   = []\n",
        "\n",
        "for seed in range(5):\n",
        "    print(f\"\\n=== TD3 Seed {seed} ===\")\n",
        "    env = gym.make(\"HalfCheetah-v4\")\n",
        "    agent = TD3(\n",
        "        env                   = env,\n",
        "        gamma                 = 0.99,\n",
        "        tau                   = 0.005,\n",
        "        bufferSize            = 100_000,\n",
        "        updateFrequencyPolicy = 2,\n",
        "        updateFrequencyValue  = 1,\n",
        "        trainPolicyFrequency  = 2,\n",
        "        policyOptimizerFn     = optim.Adam,\n",
        "        valueOptimizerFn      = optim.Adam,\n",
        "        policyOptimizerLR     = 1e-4,\n",
        "        valueOptimizerLR      = 1e-3,\n",
        "        MAX_TRAIN_EPISODES    = 500,\n",
        "        MAX_EVAL_EPISODE      = 1,\n",
        "        optimizerFn           = optim.Adam\n",
        "    )\n",
        "    trainR, trainT, evalR, wallT, _ = agent.runTD3()\n",
        "    env.close()\n",
        "\n",
        "    td3_all_train.append(trainR)\n",
        "    td3_all_eval.append(evalR)\n",
        "    td3_all_train_t.append(trainT)\n",
        "    td3_all_wall_t.append(wallT)\n",
        "    steps = np.cumsum([min(len(trainR), 1000)] * len(trainR))\n",
        "    td3_all_steps.append(steps.tolist())\n",
        "\n",
        "td3_all_train   = np.array(td3_all_train)\n",
        "td3_all_eval    = np.array(td3_all_eval)\n",
        "td3_all_steps   = np.array(td3_all_steps)\n",
        "td3_all_train_t = np.array(td3_all_train_t)\n",
        "td3_all_wall_t  = np.array(td3_all_wall_t)\n",
        "print(\"TD3 done.\")"
      ],
      "metadata": {
        "id": "fNZorApHFnYO"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "ppo_all_train   = []\n",
        "ppo_all_eval    = []\n",
        "ppo_all_steps   = []\n",
        "ppo_all_train_t = []\n",
        "ppo_all_wall_t  = []\n",
        "\n",
        "for seed in range(5):\n",
        "    print(f\"\\n=== PPO Seed {seed} ===\")\n",
        "    start = time.time()\n",
        "    results, agent = train_ppo(\n",
        "        env_id           = \"HalfCheetah-v4\",\n",
        "        seed             = seed,\n",
        "        total_timesteps  = 1_000_000,\n",
        "        num_workers      = 8,\n",
        "        num_steps        = 2048,\n",
        "        lr               = 1e-3,\n",
        "        gamma            = 0.99,\n",
        "        gae_lambda       = 0.5,\n",
        "        update_epochs    = 10,\n",
        "        num_minibatches  = 32,\n",
        "        clip_coef        = 0.3,\n",
        "        clip_vloss       = True,\n",
        "        ent_coef         = 0.0,\n",
        "        vf_coef          = 0.5,\n",
        "        max_grad_norm    = 10,\n",
        "        norm_adv         = True,\n",
        "        anneal_lr        = True,\n",
        "        target_kl        = 0.01\n",
        "    )\n",
        "    total_time = time.time() - start\n",
        "\n",
        "    ep_rewards = [r[1] for r in results]\n",
        "    ep_steps   = [r[0] for r in results]\n",
        "    n_eps      = len(ep_rewards)\n",
        "\n",
        "    # wall clock time distributed evenly across episodes\n",
        "    wall_t  = np.linspace(0, total_time, n_eps).tolist()\n",
        "    # train time per episode (approx uniform)\n",
        "    train_t = [total_time / n_eps] * n_eps\n",
        "\n",
        "    ppo_all_train.append(ep_rewards)\n",
        "    ppo_all_eval.append(ep_rewards)   # PPO has no separate eval; use train rewards\n",
        "    ppo_all_steps.append(ep_steps)\n",
        "    ppo_all_train_t.append(train_t)\n",
        "    ppo_all_wall_t.append(wall_t)\n",
        "\n",
        "# pad to same length across seeds\n",
        "max_eps = max(len(x) for x in ppo_all_train)\n",
        "def pad(lst, length, val=np.nan):\n",
        "    return lst + [val] * (length - len(lst))\n",
        "\n",
        "ppo_all_train   = np.array([pad(x, max_eps) for x in ppo_all_train])\n",
        "ppo_all_eval    = np.array([pad(x, max_eps) for x in ppo_all_eval])\n",
        "ppo_all_steps   = np.array([pad(x, max_eps) for x in ppo_all_steps])\n",
        "ppo_all_train_t = np.array([pad(x, max_eps) for x in ppo_all_train_t])\n",
        "ppo_all_wall_t  = np.array([pad(x, max_eps) for x in ppo_all_wall_t])\n",
        "print(\"PPO done.\")"
      ],
      "metadata": {
        "id": "B5AgpgLtFlhf"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import matplotlib.patches as mpatches\n",
        "\n",
        "def plot_envelope(ax, data, color, label):\n",
        "    \"\"\"Plot mean with min/max envelope across seeds.\"\"\"\n",
        "    mean = np.nanmean(data, axis=0)\n",
        "    mn   = np.nanmin(data,  axis=0)\n",
        "    mx   = np.nanmax(data,  axis=0)\n",
        "    eps  = np.arange(len(mean))\n",
        "    ax.plot(eps, mean, color=color, linewidth=2, label=label)\n",
        "    ax.fill_between(eps, mn, mx, color=color, alpha=0.2)\n",
        "\n",
        "fig, axes = plt.subplots(2, 3, figsize=(20, 12))\n",
        "fig.suptitle(\"HalfCheetah-v4 — DDPG vs TD3 vs PPO (5 seeds)\", fontsize=15)\n",
        "\n",
        "colors = {'DDPG': 'steelblue', 'TD3': 'darkorange', 'PPO': 'green'}\n",
        "\n",
        "# 1. Train rewards\n",
        "ax = axes[0, 0]\n",
        "plot_envelope(ax, ddpg_all_train,   colors['DDPG'], 'DDPG')\n",
        "plot_envelope(ax, td3_all_train,    colors['TD3'],  'TD3')\n",
        "plot_envelope(ax, ppo_all_train,    colors['PPO'],  'PPO')\n",
        "ax.set_title(\"Mean Train Rewards vs Episodes\")\n",
        "ax.set_xlabel(\"Episode\"); ax.set_ylabel(\"Train Return\")\n",
        "ax.legend(); ax.grid(True, alpha=0.3)\n",
        "\n",
        "# 2. Eval rewards\n",
        "ax = axes[0, 1]\n",
        "plot_envelope(ax, ddpg_all_eval,    colors['DDPG'], 'DDPG')\n",
        "plot_envelope(ax, td3_all_eval,     colors['TD3'],  'TD3')\n",
        "plot_envelope(ax, ppo_all_eval,     colors['PPO'],  'PPO')\n",
        "ax.set_title(\"Mean Eval Rewards vs Episodes\")\n",
        "ax.set_xlabel(\"Episode\"); ax.set_ylabel(\"Eval Return\")\n",
        "ax.legend(); ax.grid(True, alpha=0.3)\n",
        "\n",
        "# 3. Total steps vs episode\n",
        "ax = axes[0, 2]\n",
        "plot_envelope(ax, ddpg_all_steps,   colors['DDPG'], 'DDPG')\n",
        "plot_envelope(ax, td3_all_steps,    colors['TD3'],  'TD3')\n",
        "plot_envelope(ax, ppo_all_steps,    colors['PPO'],  'PPO')\n",
        "ax.set_title(\"Total Steps vs Episodes\")\n",
        "ax.set_xlabel(\"Episode\"); ax.set_ylabel(\"Cumulative Steps\")\n",
        "ax.legend(); ax.grid(True, alpha=0.3)\n",
        "\n",
        "# 4. Train time vs episode\n",
        "ax = axes[1, 0]\n",
        "plot_envelope(ax, np.cumsum(ddpg_all_train_t, axis=1), colors['DDPG'], 'DDPG')\n",
        "plot_envelope(ax, np.cumsum(td3_all_train_t,  axis=1), colors['TD3'],  'TD3')\n",
        "plot_envelope(ax, np.nancumsum(ppo_all_train_t, axis=1), colors['PPO'], 'PPO')\n",
        "ax.set_title(\"Train Time vs Episodes\")\n",
        "ax.set_xlabel(\"Episode\"); ax.set_ylabel(\"Cumulative Train Time (s)\")\n",
        "ax.legend(); ax.grid(True, alpha=0.3)\n",
        "\n",
        "# 5. Wall clock time vs episode\n",
        "ax = axes[1, 1]\n",
        "plot_envelope(ax, ddpg_all_wall_t,  colors['DDPG'], 'DDPG')\n",
        "plot_envelope(ax, td3_all_wall_t,   colors['TD3'],  'TD3')\n",
        "plot_envelope(ax, ppo_all_wall_t,   colors['PPO'],  'PPO')\n",
        "ax.set_title(\"Wall Clock Time vs Episodes\")\n",
        "ax.set_xlabel(\"Episode\"); ax.set_ylabel(\"Wall Clock Time (s)\")\n",
        "ax.legend(); ax.grid(True, alpha=0.3)\n",
        "\n",
        "# 6. Empty panel — observations text\n",
        "ax = axes[1, 2]\n",
        "ax.axis('off')\n",
        "obs_text = (\n",
        "    \"Observations:\\n\\n\"\n",
        "    \"DDPG vs TD3:\\n\"\n",
        "    \"- TD3 is more stable than DDPG due to\\n\"\n",
        "    \"  twin critics and delayed policy updates.\\n\"\n",
        "    \"- DDPG overestimates Q-values; TD3 mitigates\\n\"\n",
        "    \"  this with clipped double-Q learning.\\n\"\n",
        "    \"- TD3 generally achieves higher final reward.\\n\\n\"\n",
        "    \"PPO vs DDPG/TD3:\\n\"\n",
        "    \"- PPO uses on-policy data with clipped\\n\"\n",
        "    \"  surrogate objective — more stable updates.\\n\"\n",
        "    \"- PPO parallelises collection across workers,\\n\"\n",
        "    \"  making wall-clock time more efficient.\\n\"\n",
        "    \"- DDPG/TD3 are more sample efficient per step\\n\"\n",
        "    \"  due to replay buffers (off-policy).\\n\"\n",
        "    \"- PPO needs more total steps but is easier\\n\"\n",
        "    \"  to tune and less prone to divergence.\"\n",
        ")\n",
        "ax.text(0.05, 0.95, obs_text, transform=ax.transAxes,\n",
        "        fontsize=10, verticalalignment='top',\n",
        "        bbox=dict(boxstyle='round', facecolor='lightyellow', alpha=0.8))\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"comparison_halfcheetah.png\", dpi=150, bbox_inches='tight')\n",
        "plt.show()\n",
        "print(\"Saved comparison_halfcheetah.png\")"
      ],
