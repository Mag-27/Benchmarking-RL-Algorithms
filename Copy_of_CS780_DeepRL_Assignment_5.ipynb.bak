    {
      "cell_type": "markdown",
      "metadata": {
        "id": "aE4lZyvDEELc"
      },
      "source": [
        "# Helper Functions [20 marks]\n",
        "\n",
        "<a id=\"helper\"></a>\n",
        "\n",
        "Write all the helper functions that will be used for value-based and policy based algorithms below. In case you want to add more helper functions, please feel free to add."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "NYwFTebMEELc"
      },
      "outputs": [],
      "source": [
        "#Value Network\n",
        "def createValueNetwork(inDim, outDim, action_size, hDim = [32,32], activation = F.relu):\n",
        "    #this creates a Feed Forward Neural Network class and instantiates it and returns the class\n",
        "    #the class should be derived from torch nn.Module and it should have init and forward method at the very least\n",
        "    #the forward function should return q-value for each possible action\n",
        "\n",
        "    #Your code goes in here\n",
        "    class ValueNetwork(nn.Module):\n",
        "      def __init__(self):\n",
        "        super(ValueNetwork, self).__init__()\n",
        "\n",
        "        self.layers = nn.ModuleList()\n",
        "        prev_dim = inDim\n",
        "        for h in hDim:\n",
        "          self.layers.append(nn.Linear(prev_dim, h))\n",
        "          prev_dim = h\n",
        "        self.output_layer = nn.Linear(prev_dim, outDim)\n",
        "        self.activation = activation\n",
        "\n",
        "      def forward(self, x):\n",
        "        for layer in self.layers:\n",
        "          x = self.activation(layer(x))\n",
        "        x = self.output_layer(x)\n",
        "        return x\n",
        "    valueNetwork = ValueNetwork()\n",
        "    return valueNetwork"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "XVEIcH7kEELc"
      },
      "outputs": [],
      "source": [
        "def createPolicyNetwork(inDim, outDim, hDim=[32,32], activation=F.relu):\n",
        "\n",
        "    class PolicyNetwork(nn.Module):\n",
        "        def __init__(self):                          # ← no args here\n",
        "            super().__init__()\n",
        "            layers, prev = [], inDim                 # ← uses outer function's inDim\n",
        "            for h in hDim:                           # ← uses outer function's hDim\n",
        "                layers.append(nn.Linear(prev, h))\n",
        "                prev = h\n",
        "            self.hidden       = nn.ModuleList(layers)\n",
        "            self.mean_head    = nn.Linear(prev, outDim)\n",
        "            self.log_std_head = nn.Linear(prev, outDim)\n",
        "            self.activation   = activation           # ← uses outer function's activation\n",
        "\n",
        "        def forward(self, x):\n",
        "            for layer in self.hidden:\n",
        "                x = self.activation(layer(x))\n",
        "            mean    = self.mean_head(x)\n",
        "            log_std = self.log_std_head(x).clamp(-20, 2)\n",
        "            return mean, log_std\n",
        "\n",
        "        def selectAction(self, s):\n",
        "            mean, log_std = self.forward(s)\n",
        "            std      = log_std.exp()\n",
        "            dist     = torch.distributions.Normal(mean, std)\n",
        "            raw      = dist.rsample()\n",
        "            action   = torch.tanh(raw) * 2.0\n",
        "            log_prob = (dist.log_prob(raw)\n",
        "                        - torch.log(1 - action.pow(2) + 1e-6)).sum(-1)\n",
        "            entropy  = dist.entropy().sum(-1)\n",
        "            return action.squeeze().detach().cpu().numpy(), log_prob.squeeze(), entropy.squeeze()\n",
        "\n",
        "        def selectGreedyAction(self, s):\n",
        "            mean, _ = self.forward(s)\n",
        "            action  = torch.tanh(mean) * 2.0\n",
        "            return action.squeeze().detach().cpu().numpy()\n",
        "\n",
        "    return PolicyNetwork()          # ← instantiate and return"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "CXg_6UIji3ZF"
      },
      "outputs": [],
      "source": [
        "def stochasticExplorationTrain(pNetwork, state_tensor):\n",
        "    action, log_prob, entropy = pNetwork.selectAction(state_tensor)\n",
        "    return action, log_prob, entropy\n",
        "def greedyExplorationEval(pNetwork, state_tensor):\n",
        "    return pNetwork.selectGreedyAction(state_tensor)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "jntS3WqwuBWS"
      },
      "outputs": [],
      "source": [
        "def getStepWiseReturnsAndDiscounts(gamma, rewards):\n",
        "    \"\"\"\n",
        "    Computes n-step discounted returns and the corresponding discount factors.\n",
        "    rewards: list of length T+1 (last entry is bootstrap value).\n",
        "    Returns tensors of shape (T,).\n",
        "    \"\"\"\n",
        "    T       = len(rewards) - 1          # number of real steps\n",
        "    returns = []\n",
        "    gammas  = []\n",
        "    G = rewards[-1]                     # bootstrap from last value\n",
        "    for t in reversed(range(T)):\n",
        "        G = rewards[t] + gamma * G\n",
        "        returns.insert(0, G)\n",
        "        gammas.insert(0, gamma ** t)\n",
        "    returns = torch.stack(returns) if isinstance(returns[0], torch.Tensor) \\\n",
        "              else torch.FloatTensor(returns)\n",
        "    gammas  = torch.FloatTensor(gammas)\n",
        "    return returns, gammas\n",
        "\n",
        "\n",
        "def clipGradientNorm(params, max_norm):\n",
        "    torch.nn.utils.clip_grad_norm_(params, max_norm)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "class PolicyNetwork(nn.Module):\n",
        "    \"\"\"Actor: s -> a  (tanh output scaled to action range)\"\"\"\n",
        "    def __init__(self, obs_dim, act_dim, action_high,\n",
        "                 hiddenDims=[256, 256], activations=[nn.ReLU, nn.ReLU]):\n",
        "        super().__init__()\n",
        "        self.action_high = torch.FloatTensor(action_high)\n",
        "\n",
        "        layers = []\n",
        "        in_dim = obs_dim\n",
        "        for h_dim, act_fn in zip(hiddenDims, activations):\n",
        "            layers += [nn.Linear(in_dim, h_dim), act_fn()]\n",
        "            in_dim  = h_dim\n",
        "        layers += [nn.Linear(in_dim, act_dim), nn.Tanh()]\n",
        "        self.net = nn.Sequential(*layers)\n",
        "\n",
        "    def forward(self, s):\n",
        "        return self.net(s) * self.action_high.to(s.device)\n",
        "\n",
        "\n",
        "class ValueNetwork(nn.Module):\n",
        "    \"\"\"Critic: (s, a) -> Q\"\"\"\n",
        "    def __init__(self, obs_dim, act_dim,\n",
        "                 hiddenDims=[256, 256], activations=[nn.ReLU, nn.ReLU]):\n",
        "        super().__init__()\n",
        "\n",
        "        layers = []\n",
        "        in_dim = obs_dim + act_dim\n",
        "        for h_dim, act_fn in zip(hiddenDims, activations):\n",
        "            layers += [nn.Linear(in_dim, h_dim), act_fn()]\n",
        "            in_dim  = h_dim\n",
        "        layers += [nn.Linear(in_dim, 1)]\n",
        "        self.net = nn.Sequential(*layers)\n",
        "\n",
        "    def forward(self, s, a):\n",
        "        return self.net(torch.cat([s, a], dim=-1))"
      ],
      "metadata": {
        "id": "z4ylnj6vLI4Q"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "cXmrOE-dEELc"
      },
      "source": [
        "## ReplayBuffer [40 marks]"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "pRTbMYPqEELc"
      },
      "source": [
        "In next few cells, you will implement replaybuffer class.\n",
        "\n",
        "This class creates a buffer for storing and retrieving experiences. This is a generic class and can be used\n",
        "for different agents like NFQ, DQN, DDQN, PER_DDQN, etc.\n",
        "Following are the methods for this class which are implemented in subsequent cells\n",
        "\n",
        "```\n",
        "class ReplayBuffer():\n",
        "    def __init__(self, bufferSize, batch_size, seed)\n",
        "    def store(self, state, action, reward, next_state, done)\n",
        "    def sample(self, batchSize)\n",
        "    def length(self)\n",
        "```   "
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "rnNu7J9yEELc"
      },
      "outputs": [],
      "source": [
        "class ReplayBuffer():\n",
        "    def __init__(self, buffer_size, batch_size, seed):\n",
        "        # this function creates the relevant data-structures, and intializes all relevant variables\n",
        "        #Your code goes in here\n",
        "        self.bufferSize = buffer_size\n",
        "        self.buffer = deque(maxlen=buffer_size)\n",
        "        self.totalCollected = 0\n",
        "        self.lastEpisodeReward = 0\n",
        "        return"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "gJyfgzKeEELc"
      },
      "outputs": [],
      "source": [
        "class ReplayBuffer(ReplayBuffer):\n",
        "    def store(self, state, action, reward, next_state, done):\n",
        "        #stores the experiences, based on parameters in init\n",
        "        #\n",
        "        #this function does not return anything\n",
        "        #\n",
        "        #Your code goes in here\n",
        "        experience = (state,action,reward,next_state,done)\n",
        "        self.buffer.append(experience)\n",
        "        self.totalCollected += 1\n",
        "        return"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "cVU3nhC4EELc"
      },
      "outputs": [],
      "source": [
        "class ReplayBuffer(ReplayBuffer):\n",
        "    def sample(self, batchSize):\n",
        "        # this method returns batchSize number of experiences\n",
        "        # this function returns experiences samples\n",
        "        #\n",
        "        #Your code goes in here\n",
        "        experiencesList = random.sample(self.buffer, batchSize)\n",
        "\n",
        "        return experiencesList"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "LQxGYYbcEELc"
      },
      "outputs": [],
      "source": [
        "class ReplayBuffer(ReplayBuffer):\n",
        "    def length(self):\n",
        "        #tells the number of experiences stored in the internal buffer\n",
        "        #\n",
        "        #Your code goes in here\n",
        "        #\n",
        "        bufferSize = len(self.buffer)\n",
        "        return bufferSize"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "class ReplayBuffer(ReplayBuffer):\n",
        "  def splitExperiences(self, experiences):\n",
        "        states, actions, rewards, next_states, dones = zip(*experiences)\n",
        "        ss      = torch.FloatTensor(np.array(states))\n",
        "        acts    = torch.FloatTensor(np.array(actions))\n",
        "        rs      = torch.FloatTensor(np.array(rewards)).unsqueeze(1)\n",
        "        sNexts  = torch.FloatTensor(np.array(next_states))\n",
        "        dones_t = torch.FloatTensor(np.array(dones, dtype=np.float32)).unsqueeze(1)\n",
        "        return ss, acts, rs, sNexts, dones_t"
      ],
      "metadata": {
        "id": "0dt00HYTLRlJ"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "MHEvEtaCRQVK"
      },
      "source": [
        "# Deep Policy Based RL agents.\n",
        "<a id=\"deep-policy-based\"></a>"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "dceLwaOpRQVK"
      },
      "source": [
        "**The purpose of this part is to learn about different Deep Policy Based RL agents.**\n",
        "\n",
        "In this part of the assignment you will be implementing Deep Policy based RL algorithms we learnt in Lectures. Namely, we will be implementing REINFORCE and VPG.\n",
        "\n",
        "For all the algorithms below, this time we will not be specifying the hyper-parameters, please play with the hyper-params to come up with the best values. This way you will learn to tune the model. Some of the values were specified in the lecture, that would be a good starting point."
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "kFl25YOVRQVK"
      },
      "source": [
        "#REINFORCE [40 marks]\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "9U-kDPlERQVK"
      },
      "source": [
        "Implement the REINFORCE algorithm. We have studied about REINFORCE algorithm in the Lecture. Use the function definitions (given below).\n",
        "\n",
        "This class implements the REINFORCE Agent, you are required to implement the various methods of this class\n",
        "as outlined below. Note this class is generic and should work with any permissible Gym environment\n",
        "\n",
        "```\n",
        "class REINFORCE():\n",
        "    def __init__(env, seed, gamma,\n",
        "                 optimizerFn,\n",
        "                 optimizerLR,\n",
        "                 MAX_TRAIN_EPISODES, MAX_EVAL_EPISODES,\n",
        "                 explorationStrategyTrainFn,\n",
        "                 explorationStrategyEvalFn)\n",
        "    def initBookKeeping(self)\n",
        "    def performBookKeeping(self, train = True)\n",
        "    def runREINFORCE(self)\n",
        "    def trainAgent(self)\n",
        "    def trainPolicyNetwork(self, experiences)\n",
        "    def evaluateAgent(self)\n",
        "```"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "thGSTFY-RQVK"
      },
      "source": [
        "### Implement the methods for the REINFORCE class below"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "8MqH-8tLccMP"
      },
      "outputs": [],
      "source": [
        "class REINFORCE:\n",
        "    def __init__(self, env, seed, gamma,\n",
        "                 optimizerFn, optimizerLR,\n",
        "                 MAX_TRAIN_EPISODES, MAX_EVAL_EPISODES,\n",
        "                 explorationStrategyTrainFn=None,\n",
        "                 explorationStrategyEvalFn=None):\n",
        "\n",
        "        self.env = env\n",
        "        self.seed = seed\n",
        "        self.gamma = gamma\n",
        "        self.MAX_TRAIN_EPISODES  = MAX_TRAIN_EPISODES\n",
        "        self.MAX_EVAL_EPISODES   = MAX_EVAL_EPISODES\n",
        "        self.explorationStrategyTrainFn = explorationStrategyTrainFn\n",
        "        self.explorationStrategyEvalFn  = explorationStrategyEvalFn\n",
        "\n",
        "        torch.manual_seed(seed)\n",
        "        np.random.seed(seed)\n",
        "\n",
        "        in_dim     = env.observation_space.shape[0]         # 3 for Pendulum\n",
        "        action_dim = env.action_space.shape[0]              # 1 for Pendulum\n",
        "\n",
        "        self.pNetwork  = createPolicyNetwork(in_dim, action_dim)\n",
        "        self.optimizer = optimizerFn(self.pNetwork.parameters(), lr=optimizerLR)\n",
        "\n",
        "        self.initBookKeeping()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "jAmDgVAXccMQ"
      },
      "outputs": [],
      "source": [
        " class REINFORCE(REINFORCE):\n",
        "  def initBookKeeping(self):\n",
        "      self.trainRewards      = []   # mean reward over last 100 train episodes\n",
        "      self.evalScores        = []   # mean eval score every episode\n",
        "      self.episodeSteps      = []   # steps per train episode\n",
        "      self.trainingTimes     = []   # wall-clock seconds per episode\n",
        "      self.wallclockElapsed  = []   # cumulative wall-clock time\n",
        "      self.totalSteps        = 0\n",
        "      self._wallclock_start  = time.time()\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "GMyCgq2VccMQ"
      },
      "outputs": [],
      "source": [
        "class REINFORCE(REINFORCE):\n",
        "      def performBookKeeping(self, train=True):\n",
        "        if train:\n",
        "            # called after each training episode\n",
        "            recent = self.trainRewards[-100:]\n",
        "            self.meanReward100 = np.mean(recent) if recent else 0.0\n",
        "        else:\n",
        "            # called after each eval block inside trainAgent\n",
        "            recent = self.evalScores[-100:]\n",
        "            self.meanEvalScore100 = np.mean(recent) if recent else 0.0"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "KpEFi0sZccMQ"
      },
      "outputs": [],
      "source": [
        "class REINFORCE(REINFORCE):\n",
        "      def runREINFORCE(self):\n",
        "        resultTrain = self.trainAgent()\n",
        "        resultsEval = self.evaluateAgent()\n",
        "        return resultTrain, resultsEval"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "AJ1zPn2occMQ"
      },
      "outputs": [],
      "source": [
        "class REINFORCE(REINFORCE):\n",
        "    def trainAgent(self):\n",
        "        results = []\n",
        "        for e in range(self.MAX_TRAIN_EPISODES):\n",
        "            t_start = time.time()\n",
        "            s, _    = self.env.reset(seed=self.seed)\n",
        "            done    = False\n",
        "            rewards, logProbs = [], []\n",
        "\n",
        "            while not done:\n",
        "                s_tensor  = torch.FloatTensor(s).unsqueeze(0)\n",
        "                a, logp_a, _ = self.pNetwork.selectAction(s_tensor)\n",
        "                s, r, terminated, truncated, _ = self.env.step(\n",
        "                    np.array([a], dtype=np.float32)\n",
        "                )\n",
        "                done = terminated or truncated\n",
        "                rewards.append(r)\n",
        "                logProbs.append(logp_a)\n",
        "                self.totalSteps += 1\n",
        "\n",
        "            ep_return = sum(rewards)\n",
        "            self.trainRewards.append(ep_return)\n",
        "            self.episodeSteps.append(len(rewards))\n",
        "\n",
        "            self.trainPolicyNetwork(rewards, logProbs)\n",
        "            self.performBookKeeping(train=True)\n",
        "\n",
        "            eval_mean, eval_std = self.evaluateAgent()\n",
        "            self.evalScores.append(eval_mean)\n",
        "            self.performBookKeeping(train=False)\n",
        "\n",
        "            elapsed = time.time() - self._wallclock_start\n",
        "            ep_time = time.time() - t_start\n",
        "            self.trainingTimes.append(ep_time)\n",
        "            self.wallclockElapsed.append(elapsed)\n",
        "\n",
        "            results.append((self.totalSteps,\n",
        "                            self.meanReward100,\n",
        "                            self.meanEvalScore100,\n",
        "                            ep_time,\n",
        "                            elapsed))\n",
        "\n",
        "            if e % 10 == 0:\n",
        "                print(f\"Ep {e:4d} | train R: {ep_return:8.1f} \"\n",
        "                      f\"| eval R: {eval_mean:8.1f} ± {eval_std:.1f}\")\n",
        "\n",
        "        return results"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "hjAccUfpccMQ"
      },
      "outputs": [],
      "source": [
        "class REINFORCE(REINFORCE):\n",
        "  def trainPolicyNetwork(self, rewards, logProbs):\n",
        "      T = len(rewards)\n",
        "      G = torch.zeros(T)\n",
        "      running = 0.0\n",
        "      for t in reversed(range(T)):\n",
        "          running = rewards[t] + self.gamma * running\n",
        "          G[t]    = running\n",
        "\n",
        "      # Normalise returns for stability\n",
        "      G = (G - G.mean()) / (G.std() + 1e-8)\n",
        "\n",
        "      logProbs = torch.stack(logProbs)              # shape (T,)\n",
        "      loss     = -(G * logProbs).sum()\n",
        "\n",
        "      self.optimizer.zero_grad()\n",
        "      loss.backward()\n",
        "      # Gradient clipping helps a lot for Pendulum\n",
        "      torch.nn.utils.clip_grad_norm_(self.pNetwork.parameters(), max_norm=1.0)\n",
        "      self.optimizer.step()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "X61TtNSdccMQ"
      },
      "outputs": [],
      "source": [
        "class REINFORCE(REINFORCE):\n",
        "    def evaluateAgent(self, greedy=True):\n",
        "        rewards = []\n",
        "        for e in range(self.MAX_EVAL_EPISODES):\n",
        "            rs = 0\n",
        "            s, _ = self.env.reset(seed=self.seed + e)\n",
        "            for _ in count():\n",
        "                s_tensor = torch.FloatTensor(s).unsqueeze(0)\n",
        "                a = (self.pNetwork.selectGreedyAction(s_tensor) if greedy\n",
        "                     else self.pNetwork.selectAction(s_tensor)[0])\n",
        "                s, r, terminated, truncated, _ = self.env.step(\n",
        "                    np.array([a], dtype=np.float32)   # env expects array\n",
        "                )\n",
        "                rs += r\n",
        "                if terminated or truncated:\n",
        "                    rewards.append(rs)\n",
        "                    break\n",
        "        return np.mean(rewards), np.std(rewards)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "_q0HeTzvL0S3",
        "outputId": "27b3ce05-f195-4d27-9d0c-990f67d7391c"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Ep    0 | train R:  -1581.3 | eval R:  -1559.4 ± 142.1\n",
            "Ep   10 | train R:  -1791.7 | eval R:  -1560.8 ± 141.2\n"
          ]
        },
        {
          "output_type": "stream",
