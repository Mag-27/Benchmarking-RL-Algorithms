      ],
      "source": [
        "# We evaluate the SAC agent on multiple continuous-control\n",
        "\n",
        "\n",
        "# Environments used in this experiment\n",
        "env_names = [\"HalfCheetah-v4\"]\n",
        "\n",
        "num_runs = 3\n",
        "\n",
        "for env_name in env_names:\n",
        "\n",
        "    print(f\"\\n===== Environment: {env_name} =====\")\n",
        "\n",
        "    all_rewards = []\n",
        "\n",
        "    for run in range(num_runs):\n",
        "\n",
        "        print(f\"Run {run+1}\")\n",
        "\n",
        "        env = gym.make(env_name)\n",
        "        agent = SAC(\n",
        "            env               = env,\n",
        "            gamma             = 0.99,\n",
        "            tau               = 0.005,\n",
        "            bufferSize        = 1_000_000,\n",
        "            entropyLR         = 3e-4,\n",
        "            updateFrequency   = 1,\n",
        "            policyOptimizerFn = torch.optim.Adam,\n",
        "            valueOptimizerFn_1= torch.optim.Adam,\n",
        "            valueOptimizerFn_2= torch.optim.Adam,\n",
        "            policyOptimizerLR = 3e-4,\n",
        "            valueOptimizerLR  = 3e-4,\n",
        "            alphaOptimizerFn  = torch.optim.Adam,\n",
        "            MAX_TRAIN_EPISODES= 500,\n",
        "            MAX_EVAL_EPISODE  = 10,\n",
        "            hDims             = [256, 256],\n",
        "            batchSize         = 256,\n",
        "            minSamples        = 1000\n",
        "        )\n",
        "\n",
        "        rewards, eval_score, train_time, _ = agent.runSAC()\n",
        "\n",
        "        all_rewards.append(rewards)\n",
        "\n",
        "    all_rewards  = np.array(all_rewards)\n",
        "    mean_rewards = np.mean(all_rewards, axis=0)\n",
        "    std_rewards  = np.std(all_rewards, axis=0)\n",
        "\n",
        "    print(f\"Finished {env_name}\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def moving_average(data, window=20):\n",
        "    if len(data) < window:\n",
        "        return np.array(data)\n",
        "    return np.convolve(data, np.ones(window) / window, mode='valid')\n",
        "\n",
        "# fix all_rewards shape if it came in as 3D\n",
        "all_rewards_fixed = np.array(all_rewards)\n",
        "if all_rewards_fixed.ndim == 3:\n",
        "    all_rewards_fixed = all_rewards_fixed[:, :, 0]   # (runs, episodes)\n",
        "\n",
        "mean_r = np.mean(all_rewards_fixed, axis=0)\n",
        "std_r  = np.std(all_rewards_fixed,  axis=0)\n",
        "episodes = np.arange(len(mean_r))\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
        "fig.suptitle(\"SAC — HalfCheetah-v4\", fontsize=14)\n",
        "\n",
        "# ── Train returns ──────────────────────────────────────────────────────\n",
        "axes[0].plot(episodes, mean_r, alpha=0.3, color='steelblue', label='Mean Return')\n",
        "if len(mean_r) >= 20:\n",
        "    axes[0].plot(range(19, len(mean_r)),\n",
        "                 moving_average(mean_r, 20),\n",
        "                 color='navy', linewidth=2, label='Moving Avg (20)')\n",
        "axes[0].fill_between(episodes,\n",
        "                     mean_r - std_r,\n",
        "                     mean_r + std_r,\n",
        "                     alpha=0.2, color='steelblue')\n",
        "axes[0].set_xlabel(\"Episode\")\n",
        "axes[0].set_ylabel(\"Return\")\n",
        "axes[0].set_title(\"Train Returns\")\n",
        "axes[0].legend()\n",
        "axes[0].grid(True, alpha=0.3)\n",
        "\n",
        "# ── Cumulative mean return ─────────────────────────────────────────────\n",
        "cum_mean = np.cumsum(mean_r) / (np.arange(len(mean_r)) + 1)\n",
        "axes[1].plot(cum_mean, color='darkorange', linewidth=2)\n",
        "axes[1].set_xlabel(\"Episode\")\n",
        "axes[1].set_ylabel(\"Cumulative Mean Return\")\n",
        "axes[1].set_title(\"Cumulative Mean Return\")\n",
        "axes[1].grid(True, alpha=0.3)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"sac_HalfCheetah-v4_results.png\", dpi=150, bbox_inches='tight')\n",
        "plt.show()"
      ],
      "metadata": {
