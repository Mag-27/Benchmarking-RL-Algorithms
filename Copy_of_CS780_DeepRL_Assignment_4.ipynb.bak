        "plotMovingAvg(trainRewards_mc_nfq, episodes_mc_nfq, 'CartPole - Train Rewards (Moving Avg)')\n",
        "plotMovingAvg(evalRewards_mc_nfq,  episodes_mc_nfq, 'CartPole - Eval Rewards (Moving Avg)')\n",
        "\n",
        "plotQuantity(\n",
        "    quantityListDict = {0: trainTimes_mc_nfq},\n",
        "    totalEpisodeCount = episodes_mc_nfq,\n",
        "    descriptionList  = ['MountainCar - Train Time', 'Episodes', 'Time (s)']\n",
