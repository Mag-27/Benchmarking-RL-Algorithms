        "episodes_mc_nfq   = 20000\n",
        "steps_per_episode = 200\n",
        "total_steps_mc_nfq = episodes_mc_nfq * steps_per_episode\n",
        "\n",
        "\n",
        "\n",
        "temp_wrapper_mc_nfq = DecayingTemperature(\n",
        "    temp_start      = 0.5,    # lower start — Q-values are in [-200,0], temp<<|Q| needed\n",
        "    temp_min        = 0.2,\n",
        "    decay_type      = 'exponential',\n",
        "    total_steps     = total_steps_mc_nfq\n",
        ")\n",
        "\n",
        "env_mc = gym.make('MountainCar-v0',max_episode_steps=steps_per_episode)\n",
        "\n",
        "agent_mc_nfq = NFQ(\n",
        "    env                        = env_mc,\n",
        "    seed                       = seed_all,\n",
        "    gamma                      = 0.9,      # higher gamma — goal is far away\n",
        "    epochs                     = 3,        # more gradient steps per episode\n",
        "    bufferSize                 = 50000,     # enable replay buffer — critical for MC\n",
        "    batchSize                  = 32,\n",
        "    optimizerFn                = torch.optim.Adam,   # Adam > RMSprop here\n",
        "    optimizerLR                = 0.0005,\n",
        "    MAX_TRAIN_EPISODES         = episodes_mc_nfq,\n",
        "    MAX_EVAL_EPISODES          = 1,\n",
        "    explorationStrategyTrainFn = temp_wrapper_mc_nfq,\n",
        "    explorationStrategyEvalFn  = selectGreedyAction\n",
        ")\n",
        "trainRewards_mc_nfq, trainTimes_mc_nfq, evalRewards_mc_nfq, \\\n",
        "wallClockTimes_mc_nfq, finalEvalReward_mc_nfq = agent_mc_nfq.runNFQ()\n",
        "\n",
        "print(f\"MountainCar Final Eval Reward: {finalEvalReward_mc_nfq}\")"
      ]
    },
