      "source": [
        "episodes_mc_dqn = 18000\n",
        "steps_per_episode = 200  # increase max steps per episode\n",
        "\n",
        "total_steps_mc_dqn = episodes_mc_dqn * steps_per_episode\n",
        "\n",
        "exp_wrapper_mc_dqn = DecayingEpsilonGreedy(\n",
        "    epsilon_start = 0.8,\n",
        "    epsilon_min   = 0.05,\n",
        "    decay_type    = 'exponential',\n",
        "    total_steps   = total_steps_mc_dqn\n",
        ")\n",
        "env_mc_dqn = gym.make('MountainCar-v0')\n",
        "\n",
        "agent_mc_dqn = DQN(\n",
        "    env                        = env_mc_dqn,\n",
        "    seed                       = seed_all,\n",
        "    gamma                      = 0.99,\n",
        "    bufferSize                 = 1000000,\n",
        "    batchSize                  = 64,\n",
        "    optimizerFn                = torch.optim.RMSprop,\n",
        "    optimizerLR                = 0.0005,\n",
        "    MAX_TRAIN_EPISODES         = episodes_mc_dqn,\n",
        "    MAX_EVAL_EPISODES          = 1,\n",
        "    explorationStrategyTrainFn = exp_wrapper_mc_dqn,\n",
        "    explorationStrategyEvalFn  = selectGreedyAction,\n",
        "    updateFrequency            = 50\n",
        ")\n",
        "\n",
        "\n",
        "trainRewards_mc_dqn, trainTimes_mc_dqn, evalRewards_mc_dqn, wallClockTimes_mc_dqn, finalEvalReward_mc_dqn = agent_mc_dqn.runDQN()\n",
        "print(f\"MountainCar Final Eval Reward: {finalEvalReward_mc_dqn}\")"
      ]
    },
