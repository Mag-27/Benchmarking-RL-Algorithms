    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "32WceQ7NRQVC"
      },
      "outputs": [],
      "source": [
        "def plotQuantity(quantityListDict, totalEpisodeCount, descriptionList):\n",
        "    #this function takes in the quantityListDict and plots quantity vs episodes.\n",
        "    #quantityListListDict = {envInstanceCount: quantityList}\n",
        "    #quantityList is list of the qunatity per episode,\n",
        "    #for example it could be mean reward per episode, traintime per episode, etc.\n",
        "    #\n",
        "    #NOTE: len(quantityList) == totalEpisodeCount\n",
        "    #\n",
        "    #Since we run multiple instances of the environment, there will be variance across environments\n",
        "    #so in the plot, you will plot per episode maximum, minimum and average value across all env instances\n",
        "    #Basically, you need to envelop (e.g., via color) the quantity between max and min with mean value in between\n",
        "    #\n",
        "    #use the descriptionList parameter to put legends, title, etc.\n",
        "    #For each of the plot, create the legend on the left/right side so that it doesn't overlay on the plot lines/envelop.\n",
        "    #\n",
        "    #this is a generic function and can be used to plot any of the quantity of interest\n",
        "    #In particular we will be using this function to plot:\n",
        "    #        mean train rewards vs episodes\n",
        "    #        mean evaluation rewards vs episodes\n",
        "    #        total steps vs episode\n",
        "    #        train time vs episode\n",
        "    #        wall clock time vs episode\n",
        "    #\n",
        "    #\n",
        "    #this function doesn't return anything\n",
        "\n",
        "    #Your code goes in here\n",
        "    values = np.array(list(quantityListDict.values()))\n",
        "    episodes = np.arange(1, totalEpisodeCount + 1)\n",
        "\n",
        "    mean_vals = np.mean(values, axis=0)\n",
        "    max_vals  = np.max(values, axis=0)\n",
        "    min_vals  = np.min(values, axis=0)\n",
        "\n",
        "    fig, ax = plt.subplots(figsize=(10, 5))\n",
        "    ax.plot(episodes, mean_vals, color='royalblue', linewidth=2, label='Mean')\n",
        "    ax.plot(episodes, max_vals, color='tomato',    linewidth=1, linestyle='--', label='Max')\n",
        "    ax.plot(episodes, min_vals, color='seagreen',  linewidth=1, linestyle='--', label='Min')\n",
        "    ax.fill_between(episodes, min_vals, max_vals, alpha=0.15, color='royalblue', label='Min-Max Envelope')\n",
        "    title  = descriptionList[0] if len(descriptionList) > 0 else 'Quantity vs Episodes'\n",
        "    xlabel = descriptionList[1] if len(descriptionList) > 1 else 'Episodes'\n",
        "    ylabel = descriptionList[2] if len(descriptionList) > 2 else 'Value'\n",
        "\n",
        "    ax.set_title(title, fontsize=14, fontweight='bold')\n",
        "    ax.set_xlabel(xlabel, fontsize=12)\n",
        "    ax.set_ylabel(ylabel, fontsize=12)\n",
        "\n",
        "    ax.legend(loc='center left', bbox_to_anchor=(1.0, 0.5), fontsize=11, framealpha=0.9)\n",
        "\n",
        "    ax.grid(True, linestyle='--', alpha=0.5)\n",
        "    plt.tight_layout()\n",
        "\n",
        "    if len(descriptionList) > 3:\n",
        "        plt.savefig(descriptionList[3], bbox_inches='tight', dpi=150)\n",
        "\n",
        "    plt.show()\n",
        "\n",
        "    return"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "bVsUdSOMRQVC"
      },
      "outputs": [],
      "source": [
        "def huberLoss(error, delta):\n",
        "    condition = torch.abs(error) <= delta\n",
        "    quadratic = 0.5 * error ** 2\n",
        "    linear    = delta * (torch.abs(error) - 0.5 * delta)\n",
        "    hLoss = torch.where(condition, quadratic, linear)\n",
        "\n",
        "    return hLoss.mean()   # ✅ IMPORTANT"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "6qIsQkyNz9J_"
      },
      "outputs": [],
      "source": [
        "def plotMovingAvg(rewardsList, episodes, title, window=50):\n",
        "    rewards   = np.array(rewardsList)\n",
        "    movingAvg = pd.Series(rewards).rolling(window=window, min_periods=1).mean().values\n",
        "    eps       = np.arange(1, episodes + 1)\n",
        "\n",
        "    fig, ax = plt.subplots(figsize=(10, 5))\n",
        "\n",
        "    # raw rewards in light color\n",
        "    ax.plot(eps, rewards,   color='lightsteelblue', linewidth=0.8, alpha=0.5, label='Raw Reward')\n",
        "    # moving average in bold\n",
        "    ax.plot(eps, movingAvg, color='royalblue',      linewidth=2.0, label=f'Moving Avg (window={window})')\n",
        "\n",
        "    ax.set_title(title,      fontsize=14, fontweight='bold')\n",
        "    ax.set_xlabel('Episodes', fontsize=12)\n",
        "    ax.set_ylabel('Reward',   fontsize=12)\n",
        "    ax.legend(loc='upper left', fontsize=11)\n",
        "    ax.grid(True, linestyle='--', alpha=0.5)\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "SSi84JZcRQVC"
      },
      "outputs": [],
      "source": [
        "#in case you want to create any other helper function, the code goes in here\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "ZexwyF4sxYam"
      },
      "outputs": [],
      "source": [
        "class DecayingEpsilonGreedy:\n",
        "    def __init__(self,\n",
        "                 epsilon_start=0.2,\n",
        "                 epsilon_min=0.01,\n",
        "                 decay_type='exponential',\n",
        "                 total_steps=100000):\n",
        "\n",
        "        self.epsilon       = epsilon_start\n",
        "        self.epsilon_start = epsilon_start\n",
        "        self.epsilon_min   = epsilon_min\n",
        "        self.decay_type    = decay_type\n",
        "\n",
        "        self.total_steps = total_steps\n",
        "        self.step_count  = 0\n",
        "\n",
        "        if decay_type == 'exponential':\n",
        "            self.decay_rate = (epsilon_min / epsilon_start) ** (1.0 / total_steps)\n",
        "\n",
        "    def selectAction(self, net, state):\n",
        "        # ε-greedy action\n",
        "        action = selectEpsilonGreedyAction(net, state, self.epsilon)\n",
        "        self.step_count += 1\n",
        "        self._decay()\n",
        "\n",
        "        return action\n",
        "\n",
        "    def _decay(self):\n",
        "        if self.step_count >= self.total_steps:\n",
        "            self.epsilon = self.epsilon_min\n",
        "            return\n",
        "\n",
        "        if self.decay_type == 'exponential':\n",
        "            self.epsilon = max(\n",
        "                self.epsilon_min,\n",
        "                self.epsilon * self.decay_rate\n",
        "            )\n",
        "\n",
        "        elif self.decay_type == 'linear':\n",
        "            self.epsilon = max(\n",
        "                self.epsilon_min,\n",
        "                self.epsilon_start -\n",
        "                (self.epsilon_start - self.epsilon_min) *\n",
        "                (self.step_count / self.total_steps)\n",
        "            )\n",
        "\n",
        "        else:\n",
        "            raise ValueError(\"decay_type must be 'exponential' or 'linear'\")\n",
        "\n",
        "    def get_epsilon(self):\n",
        "        return self.epsilon"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "2FVgtMok1mhS"
      },
      "outputs": [],
      "source": [
        "class DecayingtempGreedy:\n",
        "    def __init__(self,\n",
        "                 temp_start=0.2,\n",
        "                 temp_min=0.01,\n",
        "                 decay_type='exponential',\n",
        "                 total_steps=100000):\n",
        "\n",
        "        self.temp       = temp_start\n",
        "        self.temp_start = temp_start\n",
        "        self.temp_min   = temp_min\n",
        "        self.decay_type    = decay_type\n",
        "\n",
        "        self.total_steps = total_steps\n",
        "        self.step_count  = 0\n",
        "\n",
        "        if decay_type == 'exponential':\n",
        "            self.decay_rate = (temp_min / temp_start) ** (1.0 / total_steps)\n",
        "\n",
        "    def selectAction(self, net, state):\n",
        "        # ε-greedy action\n",
        "        action = selectSoftMaxAction(net, state, self.temp)\n",
        "        self.step_count += 1\n",
        "        self._decay()\n",
        "\n",
        "        return action\n",
        "\n",
        "    def _decay(self):\n",
        "        if self.step_count >= self.total_steps:\n",
        "            self.temp = self.temp_min\n",
        "            return\n",
        "\n",
        "        if self.decay_type == 'exponential':\n",
        "            self.temp = max(\n",
        "                self.temp_min,\n",
        "                self.temp * self.decay_rate\n",
        "            )\n",
        "\n",
        "        elif self.decay_type == 'linear':\n",
        "            self.temp = max(\n",
        "                self.temp_min,\n",
        "                self.temp_start -\n",
        "                (self.temp_start - self.temp_min) *\n",
        "                (self.step_count / self.total_steps)\n",
        "            )\n",
        "\n",
        "        else:\n",
        "            raise ValueError(\"decay_type must be 'exponential' or 'linear'\")\n",
        "\n",
        "    def get_temp(self):\n",
        "        return self.temp\n",
        "    def get_epsilon(self):\n",
        "       return self.temp"
      ]
    },
