      "source": [
        "episodes_nfq= 1000\n",
        "steps_per_episode= 200  # increase max steps per episode\n",
        "\n",
        "total_steps_cp_nfq = 0.3* episodes_nfq* steps_per_episode\n",
        "exp_wrapper_cp_nfq= DecayingEpsilonGreedy(\n",
        "    epsilon_start = 0.8,\n",
        "    epsilon_min   = 0.01,\n",
        "    decay_type    = 'exponential',\n",
        "    total_steps   = total_steps_cp_nfq\n",
        ")\n",
        "\n",
        "env_cp = gym.make('CartPole-v0')\n",
        "\n",
        "agent_cp_nfq = NFQ(\n",
        "    env                        = env_cp,\n",
        "    seed                       = seed_all,\n",
        "    gamma                      = 0.98,\n",
        "    epochs                     = 5,\n",
        "    bufferSize                 = None,\n",
        "    batchSize                  = 256,\n",
        "    optimizerFn                = torch.optim.RMSprop,\n",
        "    optimizerLR                = 0.0005,\n",
        "    MAX_TRAIN_EPISODES         = episodes_nfq,\n",
        "    MAX_EVAL_EPISODES          = 1,\n",
        "    explorationStrategyTrainFn = exp_wrapper_cp_nfq,\n",
        "    explorationStrategyEvalFn  = selectGreedyAction\n",
        ")"
      ]
    },
